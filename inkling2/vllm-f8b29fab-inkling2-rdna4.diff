+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MXFP4 expert weights on ROCm: requantization from NVFP4 and the GEMM."""
+
+import pytest
+import torch
+
+from vllm.models.inkling2.amd.ops import mxfp4
+
+DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
+
+
+def test_e2m1_codes_round_trip():
+    lut = mxfp4.e2m1_lut(torch.device("cpu"))
+    codes = mxfp4._quantize_e2m1(lut.clone())
+    # -0.0 keeps its sign bit; every value maps back to itself.
+    assert torch.equal(lut[codes.long()], lut)
+
+
+def test_quantize_mxfp4_exact_on_representable():
+    torch.manual_seed(0)
+    codes = torch.randint(0, 16, (4, 64, 128), dtype=torch.uint8)
+    exponents = torch.randint(110, 130, (4, 64, 4), dtype=torch.uint8)
+    packed = (codes[..., 0::2] | (codes[..., 1::2] << 4)).contiguous()
+    w = mxfp4.dequantize_mxfp4(packed, exponents)
+    packed2, exponents2 = mxfp4.quantize_mxfp4(w)
+    torch.testing.assert_close(mxfp4.dequantize_mxfp4(packed2, exponents2), w, rtol=0, atol=0)
+
+
+def _random_nvfp4(experts, n, k, device):
+    packed = torch.randint(0, 256, (experts, n, k // 2), dtype=torch.uint8, device=device)
+    scale = (torch.rand(experts, n, k // 16, device=device) * 3 + 0.5).to(torch.float8_e4m3fn)
+    outer = torch.rand(experts, device=device) * 0.01 + 0.001
+    return packed, scale, outer
+
+
+def test_requantize_nvfp4_error_is_small():
+    torch.manual_seed(0)
+    packed, scale, outer = _random_nvfp4(3, 64, 256, DEVICE)
+    out, exponents, err = mxfp4.requantize_nvfp4(packed, scale, outer)
+    assert out.shape == packed.shape and exponents.shape == (3, 64, 8)
+    # Uniform random codes are the worst case for a coarser grid.
+    assert err < 0.2
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a GPU")
+@pytest.mark.parametrize("n,k", [(2304, 2304), (2304, 1152)])
+def test_mxfp4_bmm_matches_reference(n, k):
+    from vllm.models.inkling2.amd.ops import triton_bmm
+
+    torch.manual_seed(0)
+    experts = 8
+    plan = triton_bmm.ExpertPlan(tile=16, max_ctas=2)
+    act = (torch.randn(plan.rows, k, device=DEVICE) * 0.5).to(torch.float8_e4m3fn)
+    # Unit activation scales: their tile layout is covered by the MXFP8 tests.
+    act_scale = torch.full((plan.rows * (k // 32) + 4096,), 127, dtype=torch.uint8, device=DEVICE)
+    w = torch.randn(experts, n, k, device=DEVICE) * 0.02
+    packed, exponents = mxfp4.quantize_mxfp4(w)
+    tiles = torch.tensor([3, 5, 16, 28, 2, 0, 0], dtype=torch.int32, device=DEVICE)
+    out = triton_bmm.bmm(act, act_scale, packed, exponents, tiles, plan)
+    wq = mxfp4.dequantize_mxfp4(packed, exponents)
+    for rows, expert in ((slice(0, 16), 3), (slice(16, 28), 5)):
+        ref = act[rows].float() @ wq[expert].t()
+        torch.testing.assert_close(out[rows].float(), ref, rtol=2e-2, atol=ref.abs().max().item() * 5e-3)
