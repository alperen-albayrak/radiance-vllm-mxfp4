+
+    def embed_multimodal(self, **kwargs: object) -> MultiModalEmbeddings:
+        patches = kwargs.get("vision_pixels")
+        grid_thw = kwargs.get("vision_grid_thw")
+        if patches is None or grid_thw is None:
