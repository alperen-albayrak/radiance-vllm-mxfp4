--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/attn_res.py
@@ -0,0 +1,302 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Block attention residual: softmax-weighted mix of residual stream blocks.
+
+For each token, sources `x_n` (stored blocks, then the partial block plus an
+optional addend, all in fp32) are scored as `(q . x_n) * rsqrt(mean(x_n^2) +
+eps)` per pseudo-query `q`; the output is `sum_n softmax_n * x_n`, with
+`x_n` RMS-normalized when `normalize_values` is set. The fp32 mix then
+goes through the following sublayer's RMSNorm in the same kernel.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, tldevice, triton
+
+
+@triton.jit
+def _load_source(
+    Stack, stride_s, Last, Addend, row_off, offs, mask, n, N_STACK, HAS_ADDEND
+):
+    if n < N_STACK:
+        x = tl.load(Stack + n * stride_s + row_off + offs, mask, other=0)
+        x = x.to(tl.float32)
+    else:
+        x = tl.load(Last + row_off + offs, mask, other=0).to(tl.float32)
+        if HAS_ADDEND:
+            x = x + tl.load(Addend + row_off + offs, mask, other=0).to(tl.float32)
+    return x
+
+
+@triton.jit
+def _mix(
+    Stack,
+    stride_s,
+    Last,
+    Addend,
+    row_off,
+    offs,
+    mask,
+    probs,
+    n_idx,
+    N_STACK,
+    HAS_ADDEND,
+    BLOCK_D,
+):
+    acc = tl.zeros((BLOCK_D,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        x = _load_source(
+            Stack, stride_s, Last, Addend, row_off, offs, mask, n, N_STACK, HAS_ADDEND
+        )
+        acc = tl.fma(tl.sum(tl.where(n_idx == n, probs, 0.0)), x, acc)
+    return acc
+
+
+@triton.jit
+def _attn_res_kernel(
+    Stack,
+    Last,
+    Addend,
+    Queries,
+    NormW,
+    Out,
+    stride_s,
+    T,
+    eps,
+    norm_eps,
+    D: tl.constexpr,
+    N_STACK: tl.constexpr,
+    HAS_ADDEND: tl.constexpr,
+    NORMALIZE: tl.constexpr,
+    HAS_NORM: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    # One program per (token, query).
+    t = tl.program_id(1).to(tl.int64)
+    q_off = tl.program_id(0) * D
+    row_off = t * D
+    n_idx = tl.arange(0, BLOCK_N)
+    d_idx = tl.arange(0, BLOCK_D)
+
+    # Pass 1: per-source inverse RMS and query dot products.
+    logits = tl.full((BLOCK_N,), float("-inf"), tl.float32)
+    inv_rms = tl.zeros((BLOCK_N,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        sum_sq = tl.zeros((BLOCK_D,), tl.float32)
+        dots = tl.zeros((BLOCK_D,), tl.float32)
+        for d0 in tl.range(0, D, BLOCK_D):
+            offs = d0 + d_idx
+            mask = offs < D
+            x = _load_source(
+                Stack,
+                stride_s,
+                Last,
+                Addend,
+                row_off,
+                offs,
+                mask,
+                n,
+                N_STACK,
+                HAS_ADDEND,
+            )
+            q = tl.load(Queries + q_off + offs, mask, other=0)
+            sum_sq = tl.fma(x, x, sum_sq)
+            dots = tl.fma(q, x, dots)
+        rstd = tl.rsqrt(tl.fma(tl.sum(sum_sq), 1.0 / D, eps))
+        inv_rms = tl.where(n_idx == n, rstd, inv_rms)
+        logits = tl.where(n_idx == n, tl.sum(dots) * rstd, logits)
+
+    probs = tldevice.exp(logits - tl.max(logits))
+    inv_sum = tl.div_rn(1.0, tl.sum(probs))
+    if NORMALIZE:
+        probs = probs * inv_rms
+
+    # Pass 2: RMS of the probability-weighted sum; pass 3: normalized sum.
+    sum_sq = 0.0
+    for d0 in tl.range(0, D, BLOCK_D):
+        offs = d0 + d_idx
+        acc = (
+            _mix(
+                Stack,
+                stride_s,
+                Last,
+                Addend,
+                row_off,
+                offs,
+                offs < D,
+                probs,
+                n_idx,
+                N_STACK,
+                HAS_ADDEND,
+                BLOCK_D,
+            )
+            * inv_sum
+        )
+        sum_sq += tl.sum(acc * acc)
+    out_rstd = tl.rsqrt(tl.div_rn(sum_sq, D) + norm_eps)
+    out = Out + tl.program_id(0).to(tl.int64) * T * D + row_off
+    for d0 in tl.range(0, D, BLOCK_D):
+        offs = d0 + d_idx
+        mask = offs < D
+        acc = (
+            _mix(
+                Stack,
+                stride_s,
+                Last,
+                Addend,
+                row_off,
+                offs,
+                mask,
+                probs,
+                n_idx,
+                N_STACK,
+                HAS_ADDEND,
+                BLOCK_D,
+            )
+            * inv_sum
+        )
+        if HAS_NORM:
+            w = tl.load(NormW + q_off + offs, mask, other=0).to(tl.float32)
+            acc = acc * out_rstd * w
+        tl.store(out + offs, acc.to(Out.dtype.element_ty), mask)
+
+
+@triton.jit
+def _attn_res_row_kernel(
+    Stack,
+    Last,
+    Addend,
+    Queries,
+    NormW,
+    Out,
+    stride_s,
+    T,
+    eps,
+    norm_eps,
+    D: tl.constexpr,
+    N_STACK: tl.constexpr,
+    HAS_ADDEND: tl.constexpr,
+    NORMALIZE: tl.constexpr,
+    HAS_NORM: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_A: tl.constexpr,
+    BLOCK_B: tl.constexpr,
+):
+    # Small batches: one program per (token, query) holds the row in registers
+    # as a power-of-2 head [0, BLOCK_A) and a masked tail [BLOCK_A, D), so the
+    # sources are read twice instead of three times.
+    t = tl.program_id(1).to(tl.int64)
+    q_off = tl.program_id(0) * D
+    row_off = t * D
+    da = tl.arange(0, BLOCK_A)
+    db = BLOCK_A + tl.arange(0, BLOCK_B)
+    mask_a = da < D
+    mask_b = db < D
+    n_idx = tl.arange(0, BLOCK_N)
+    qa = tl.load(Queries + q_off + da, mask_a, other=0)
+    qb = tl.load(Queries + q_off + db, mask_b, other=0)
+    src = (Stack, stride_s, Last, Addend, row_off)
+
+    logits = tl.full((BLOCK_N,), float("-inf"), tl.float32)
+    inv_rms = tl.zeros((BLOCK_N,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        xa = _load_source(*src, da, mask_a, n, N_STACK, HAS_ADDEND)
+        xb = _load_source(*src, db, mask_b, n, N_STACK, HAS_ADDEND)
+        rstd = tl.rsqrt(tl.fma(tl.sum(xa * xa) + tl.sum(xb * xb), 1.0 / D, eps))
+        inv_rms = tl.where(n_idx == n, rstd, inv_rms)
+        dot = tl.sum(qa * xa) + tl.sum(qb * xb)
+        logits = tl.where(n_idx == n, dot * rstd, logits)
+
+    probs = tldevice.exp(logits - tl.max(logits))
+    inv_sum = tl.div_rn(1.0, tl.sum(probs))
+    if NORMALIZE:
+        probs = probs * inv_rms
+
+    acc_a = tl.zeros((BLOCK_A,), tl.float32)
+    acc_b = tl.zeros((BLOCK_B,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        p = tl.sum(tl.where(n_idx == n, probs, 0.0))
+        xa = _load_source(*src, da, mask_a, n, N_STACK, HAS_ADDEND)
+        xb = _load_source(*src, db, mask_b, n, N_STACK, HAS_ADDEND)
+        acc_a = tl.fma(p, xa, acc_a)
+        acc_b = tl.fma(p, xb, acc_b)
+    acc_a = acc_a * inv_sum
+    acc_b = acc_b * inv_sum
+    sum_sq = tl.sum(acc_a * acc_a) + tl.sum(acc_b * acc_b)
+    out_rstd = tl.rsqrt(tl.div_rn(sum_sq, D) + norm_eps)
+    out = Out + tl.program_id(0).to(tl.int64) * T * D + row_off
+    if HAS_NORM:
+        wa = tl.load(NormW + q_off + da, mask_a, other=0).to(tl.float32)
+        wb = tl.load(NormW + q_off + db, mask_b, other=0).to(tl.float32)
+        acc_a = acc_a * out_rstd * wa
+        acc_b = acc_b * out_rstd * wb
+    tl.store(out + da, acc_a.to(Out.dtype.element_ty), mask_a)
+    tl.store(out + db, acc_b.to(Out.dtype.element_ty), mask_b)
+
+
+def attn_res(
+    stack: torch.Tensor,
+    last: torch.Tensor,
+    addend: torch.Tensor | None,
+    queries: torch.Tensor,
+    norm_weight: torch.Tensor | None,
+    norm_eps: float,
+    normalize_values: bool,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Mix `[*stack, last (+ addend)]` with each pseudo-query.
+
+    `queries` are fp32 `(Q, D)`, already scaled by `D**-0.5`; each fp32
+    mix is RMS-normalized with its row of `norm_weight` `(Q, D)`. Returns
+    `(Q, T, D)` in `last.dtype`, or without `norm_weight` the fp32 mixes
+    themselves (the loop blends its messages into them).
+    """
+    num_tokens, d = last.shape
+    num_stack = stack.shape[0]
+    num_q = queries.shape[0]
+    assert last.is_contiguous() and queries.is_contiguous()
+    assert queries.dtype == torch.float32
+    assert stack.stride(1) == d and stack.stride(2) == 1
+    if addend is not None:
+        assert addend.is_contiguous() and addend.shape == last.shape
+    has_norm = norm_weight is not None
+    if norm_weight is not None:
+        assert norm_weight.shape == queries.shape and norm_weight.is_contiguous()
+    else:
+        # Never read.
+        norm_weight = queries
+    out_dtype = last.dtype if has_norm else torch.float32
+    out = torch.empty((num_q, num_tokens, d), dtype=out_dtype, device=last.device)
+    args = (
+        stack,
+        last,
+        addend,
+        queries,
+        norm_weight,
+        out,
+        stack.stride(0),
+        num_tokens,
+        eps,
+        norm_eps,
+    )
+    meta = dict(
+        D=d,
+        N_STACK=num_stack,
+        HAS_ADDEND=addend is not None,
+        NORMALIZE=normalize_values,
+        HAS_NORM=has_norm,
+        BLOCK_N=triton.next_power_of_2(num_stack + 1),
+        enable_fp_fusion=False,
+    )
+    # The queries of a token run back to back and share its sources in L2.
+    grid = (num_q, num_tokens)
+    if num_tokens * num_q <= 256:
+        block_a = triton.next_power_of_2(d + 1) // 2
+        block_b = max(triton.next_power_of_2(d - block_a), 16)
+        _attn_res_row_kernel[grid](
+            *args, **meta, BLOCK_A=block_a, BLOCK_B=block_b, num_warps=8
+        )
+    else:
+        _attn_res_kernel[grid](*args, **meta, BLOCK_D=1024, num_warps=4)
+    return out
diff --git a/vllm/models/inkling2/amd/ops/dspark.py b/vllm/models/inkling2/amd/ops/dspark.py
new file mode 100644
index 0000000000..74d45727b9
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/dspark.py
@@ -0,0 +1,268 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Kernels of the Inkling2 DSpark draft, matching the reference implementation."""
+
+import torch
+
+from vllm.distributed import tensor_model_parallel_all_gather
+from vllm.triton_utils import tl, tldevice, triton
+
+
+@triton.jit
+def _mix_rmsnorm_kernel(
+    X,
+    ALPHA,
+    WEIGHT,
+    OUT,
+    ROW_STRIDE: tl.constexpr,
+    TAP_STRIDE: tl.constexpr,
+    HIDDEN_STRIDE: tl.constexpr,
+    TAPS: tl.constexpr,
+    HIDDEN: tl.constexpr,
+    EPS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    h = tl.arange(0, BLOCK)
+    mixed = tl.full((BLOCK,), 0, tl.float32)
+    for tap in tl.static_range(TAPS):
+        x = tl.load(
+            X + row * ROW_STRIDE + tap * TAP_STRIDE + h * HIDDEN_STRIDE,
+            h < HIDDEN,
+            0,
+        ).to(tl.float32)
+        alpha = tl.load(ALPHA + tap).to(tl.float32)
+        mixed += x * alpha
+    inv_rms = tl.rsqrt(tl.sum(mixed * mixed, 0) / HIDDEN + EPS)
+    weight = tl.load(WEIGHT + h, h < HIDDEN, 0).to(tl.float32)
+    tl.store(OUT + row * HIDDEN + h, mixed * inv_rms * weight, h < HIDDEN)
+
+
+def mix_rmsnorm(
+    targets: torch.Tensor, alpha: torch.Tensor, weight: torch.Tensor, eps: float
+) -> torch.Tensor:
+    """RMSNorm of the `alpha`-weighted sum of `targets[:, i]` (fp32 math).
+
+    `targets` is `(rows, taps, hidden)`; the output has `targets.dtype`.
+    """
+    rows, taps, hidden = targets.shape
+    assert alpha.shape == (taps,) and alpha.is_contiguous()
+    assert weight.shape == (hidden,) and weight.is_contiguous()
+    out = targets.new_empty((rows, hidden))
+    if rows:
+        _mix_rmsnorm_kernel[(rows,)](
+            targets,
+            alpha,
+            weight,
+            out,
+            *targets.stride(),
+            taps,
+            hidden,
+            eps,
+            triton.next_power_of_2(hidden),
+            num_warps=8,
+        )
+    return out
+
+
+@triton.jit
+def _qk_norm_rope_kernel(
+    X,
+    Q_WEIGHT,
+    K_WEIGHT,
+    COS_SIN,
+    POS,
+    row_stride,
+    q_size,
+    NHQ: tl.constexpr,
+    D: tl.constexpr,
+    EPS: tl.constexpr,
+    NORM: tl.constexpr,
+):
+    t = tl.program_id(0).to(tl.int64)
+    h = tl.program_id(1)
+    pos = tl.load(POS + t).to(tl.int64)
+
+    HALF: tl.constexpr = D // 2
+    half_ar = tl.arange(0, HALF)
+    d_ar = tl.arange(0, D)
+    cos = tl.load(COS_SIN + pos * D + half_ar).to(tl.float32)
+    sin = tl.load(COS_SIN + pos * D + HALF + half_ar).to(tl.float32)
+
+    is_q = h < NHQ
+    col0 = tl.where(is_q, h * D, q_size + (h - NHQ) * D).to(tl.int64)
+    row = X + t * row_stride + col0
+    if NORM:
+        w_ptr = tl.where(is_q, Q_WEIGHT.to(tl.int64), K_WEIGHT.to(tl.int64)).to(
+            tl.pointer_type(tl.bfloat16)
+        )
+        x = tl.load(row + d_ar).to(tl.float32)
+        ms = tl.sum(x * x, 0) / D
+        inv = 1.0 / tl.sqrt(ms + EPS)
+        w1 = tl.load(w_ptr + half_ar).to(tl.float32)
+        w2 = tl.load(w_ptr + HALF + half_ar).to(tl.float32)
+        x1 = tl.load(row + half_ar).to(tl.float32) * inv * w1
+        x2 = tl.load(row + HALF + half_ar).to(tl.float32) * inv * w2
+        x1 = x1.to(tl.bfloat16).to(tl.float32)
+        x2 = x2.to(tl.bfloat16).to(tl.float32)
+    else:
+        x1 = tl.load(row + half_ar).to(tl.float32)
+        x2 = tl.load(row + HALF + half_ar).to(tl.float32)
+    o1 = x1 * cos - x2 * sin
+    o2 = x2 * cos + x1 * sin
+    tl.store(row + half_ar, o1.to(tl.bfloat16))
+    tl.store(row + HALF + half_ar, o2.to(tl.bfloat16))
+
+
+def qk_norm_rope_(
+    qkv: torch.Tensor,
+    positions: torch.Tensor,
+    q_weight: torch.Tensor,
+    k_weight: torch.Tensor,
+    cos_sin_cache: torch.Tensor,
+    num_q_heads: int,
+    num_k_heads: int,
+    eps: float,
+) -> None:
+    """In-place per-head Q/K RMSNorm (rounded to bf16) + neox RoPE on the
+    leading `num_q_heads + num_k_heads` heads of the fused `qkv`."""
+    head_dim = cos_sin_cache.shape[-1]
+    if qkv.shape[0]:
+        _qk_norm_rope_kernel[(qkv.shape[0], num_q_heads + num_k_heads)](
+            qkv,
+            q_weight,
+            k_weight,
+            cos_sin_cache,
+            positions,
+            qkv.stride(0),
+            num_q_heads * head_dim,
+            NHQ=num_q_heads,
+            D=head_dim,
+            EPS=eps,
+            NORM=True,
+        )
+
+
+def rope_(x: torch.Tensor, positions: torch.Tensor, cos_sin_cache: torch.Tensor):
+    """In-place neox RoPE on `x` of shape `(T, H, D)` (fp32 math)."""
+    num_tokens, num_heads, head_dim = x.shape
+    assert x.stride(1) == head_dim and x.stride(2) == 1
+    if num_tokens:
+        _qk_norm_rope_kernel[(num_tokens, num_heads)](
+            x,
+            x,
+            x,
+            cos_sin_cache,
+            positions,
+            x.stride(0),
+            0,
+            NHQ=0,
+            D=head_dim,
+            EPS=0.0,
+            NORM=False,
+        )
+
+
+@triton.jit
+def _silu_and_mul_kernel(X, Y, stride_x, N: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = cols < N
+    gate = tl.load(X + row * stride_x + cols, mask, other=0).to(tl.float32)
+    up = tl.load(X + row * stride_x + N + cols, mask, other=0).to(tl.float32)
+    silu = tl.div_rn(gate, 1.0 + tldevice.exp(-gate))
+    tl.store(Y + row * N + cols, (silu * up).to(Y.dtype.element_ty), mask)
+
+
+def silu_and_mul(x: torch.Tensor) -> torch.Tensor:
+    """`silu(gate) * up` in fp32 (precise exp/div), rounded once."""
+    num_tokens, width = x.shape
+    n = width // 2
+    out = x.new_empty((num_tokens, n))
+    if num_tokens:
+        _silu_and_mul_kernel[(num_tokens, triton.cdiv(n, 1024))](
+            x, out, x.stride(0), n, 1024, num_warps=4
+        )
+    return out
+
+
+@triton.jit
+def _add_softcap_kernel(A, B, OUT, stride_a, stride_b, softcap, N, BLOCK: tl.constexpr):
+    row = tl.program_id(1).to(tl.int64)
+    cols = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = cols < N
+    a = tl.load(A + row * stride_a + cols, mask, other=0).to(tl.float32)
+    b = tl.load(B + row * stride_b + cols, mask, other=0).to(tl.float32)
+    x = (a + b).to(tl.bfloat16)
+    x = x / softcap
+    x = tldevice.tanh(x)
+    x = x * softcap
+    tl.store(OUT + row * N + cols, x.to(tl.bfloat16), mask)
+
+
+def add_softcap(a: torch.Tensor, b: torch.Tensor, softcap: float) -> torch.Tensor:
+    """bf16 `softcap * tanh(bf16(a + b) / softcap)` of two bf16 2D tensors."""
+    rows, n = a.shape
+    assert a.stride(1) == 1 and b.stride(1) == 1
+    out = a.new_empty((rows, n))
+    if rows:
+        _add_softcap_kernel[(triton.cdiv(n, 1024), rows)](
+            a, b, out, a.stride(0), b.stride(0), softcap, n, 1024
+        )
+    return out
+
+
+@triton.jit
+def _round_bf16(x):
+    # fp32 -> bf16 -> fp32 (round to nearest even) on the bits: the compiler
+    # folds an extf(truncf(x)) pair, and with it fuses mul + add into an FMA.
+    bits = x.to(tl.uint32, bitcast=True)
+    bits = (bits + 0x7FFF + ((bits >> 16) & 1)) & 0xFFFF0000
+    return bits.to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _markov_gate_kernel(RAW, STATE, OUT, LATENT, RANK: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    c = tl.arange(0, RANK)
+    raw = RAW + row * 3 * RANK + c
+    gate = _round_bf16(tl.load(raw))
+    cand = _round_bf16(tl.load(raw + RANK))
+    out = _round_bf16(tl.load(raw + 2 * RANK))
+    state = tl.load(STATE + row * RANK + c).to(tl.float32)
+    # Each torch op of the reference rounds to bf16; its sigmoid is
+    # 1 / (1 + expf(-x)) with IEEE division.
+    gate = _round_bf16(tl.div_rn(1.0, 1.0 + tldevice.exp(-gate)))
+    cand = _round_bf16(tldevice.tanh(cand))
+    keep = _round_bf16(gate * state)
+    update = _round_bf16(_round_bf16(1.0 - gate) * cand)
+    tl.store(OUT + row * RANK + c, (keep + update).to(tl.bfloat16))
+    tl.store(LATENT + row * RANK + c, tldevice.tanh(out).to(tl.bfloat16))
+
+
+def markov_gate(
+    raw: torch.Tensor, state: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """The recurrent head's gating of the fp32 `rnn_proj` output `raw`
+    (rounded to bf16 first), as the reference's bf16 torch ops: returns
+    `(gate * state + (1 - gate) * tanh(cand), tanh(out))`."""
+    rows, rank = state.shape
+    assert raw.shape == (rows, 3 * rank) and raw.is_contiguous()
+    assert state.is_contiguous() and rank & (rank - 1) == 0
+    out, latent = torch.empty_like(state), torch.empty_like(state)
+    if rows:
+        _markov_gate_kernel[(rows,)](raw, state, out, latent, rank)
+    return out, latent
+
+
+def dspark_argmax(
+    base: torch.Tensor, bias: torch.Tensor, softcap: float, valid: int
+) -> torch.Tensor:
+    """First argmax (NaN as -inf) of every TP rank's `add_softcap(base, bias,
+    softcap)[:, :valid]` (its vocabulary shard, in rank order), from the
+    all-gathered logits."""
+    assert base.dtype == bias.dtype == torch.bfloat16 and base.shape == bias.shape
+    logits = add_softcap(base, bias, softcap)
+    logits[:, valid:] = float("-inf")
+    logits = tensor_model_parallel_all_gather(logits)
+    return logits.masked_fill(logits.isnan(), float("-inf")).argmax(-1)
diff --git a/vllm/models/inkling2/amd/ops/linear.py b/vllm/models/inkling2/amd/ops/linear.py
new file mode 100644
index 0000000000..cdfa59f26e
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/linear.py
@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""bf16 linears as the reference `linear`: fp32 accumulation in ordered
+1024-wide K groups."""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _k_group_tile(
+    X,
+    W,
+    Y,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    SPLIT: tl.constexpr,
+    pid_n,
+    pid_m,
+    pid_k,
+):
+    # With SPLIT, each program computes one K group's partial; otherwise it
+    # sums the groups in order.
+    cols = pid_n * BN + tl.arange(0, BN)
+    rows = pid_m * BM + tl.arange(0, BM)
+    ks = tl.arange(0, 128)
+    first = pid_k if SPLIT else 0
+    NUM_GROUPS: tl.constexpr = 1 if SPLIT else (K + 1023) // 1024
+    total = tl.zeros((BM, BN), tl.float32)
+    for g in tl.static_range(NUM_GROUPS):
+        group = first + g
+        partial = tl.zeros((BM, BN), tl.float32)
+        for tile in range(8):
+            k = group * 1024 + tile * 128 + ks
+            x = tl.load(
+                X + rows[:, None] * K + k[None, :],
+                (rows[:, None] < M) & (k[None, :] < K),
+                other=0,
+            )
+            w = tl.load(
+                W + cols[None, :] * K + k[:, None],
+                (cols[None, :] < N) & (k[:, None] < K),
+                other=0,
+            )
+            partial = tl.dot(x, w, partial)
+        total = partial if g == 0 else total + partial
+    tl.store(
+        Y + (first * M + rows[:, None]) * N + cols[None, :],
+        total.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & (cols[None, :] < N),
+    )
+
+
+@triton.jit
+def _k_group_kernel(
+    X,
+    W,
+    Y,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    SPLIT: tl.constexpr,
+):
+    _k_group_tile(
+        X,
+        W,
+        Y,
+        M,
+        N,
+        K,
+        BM,
+        BN,
+        SPLIT,
+        tl.program_id(0),
+        tl.program_id(1),
+        tl.program_id(2),
+    )
+
+
+@triton.jit
+def _k_group_sum_kernel(Partials, Y, MN, GROUPS: tl.constexpr, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < MN
+    total = tl.load(Partials + offs, mask)
+    for group in range(1, GROUPS):
+        total = total + tl.load(Partials + group * MN + offs, mask)
+    tl.store(Y + offs, total, mask)
+
+
+def k_group_partials(
+    x: torch.Tensor, weight: torch.Tensor, out_dtype: torch.dtype = torch.float32
+) -> torch.Tensor:
+    """fp32 partials [G, T, N] of `x @ weight.T` whose in-order sum over G is
+    the reference `linear`. G is 1 (already summed, in `out_dtype`) when
+    there are enough rows to fill the GPU without splitting K."""
+    assert x.is_contiguous() and weight.is_contiguous()
+    tokens, hidden = x.shape
+    n = weight.shape[0]
+    block_m = 16 if tokens <= 128 else 64
+    block_n = 32 if tokens <= 16 else 64 if tokens <= 256 else 128
+    groups = triton.cdiv(hidden, 1024)
+    split = groups > 1 and tokens < 4096
+    out = torch.empty(
+        (groups if split else 1, tokens, n),
+        dtype=torch.float32 if split else out_dtype,
+        device=x.device,
+    )
+    grid = (
+        triton.cdiv(n, block_n),
+        triton.cdiv(tokens, block_m),
+        groups if split else 1,
+    )
+    _k_group_kernel[grid](
+        x,
+        weight,
+        out,
+        tokens,
+        n,
+        hidden,
+        block_m,
+        block_n,
+        split,
+        num_warps=4 if block_n <= 64 else 8,
+        # gfx950's 160 KB of LDS fits two stages of the largest tiles.
+        num_stages=2,
+        enable_fp_fusion=False,
+    )
+    return out
+
+
+def linear_k_groups(
+    x: torch.Tensor, weight: torch.Tensor, out_dtype: torch.dtype = torch.float32
+) -> torch.Tensor:
+    """`x @ weight.T` for bf16 `x` [T, K] and `weight` [N, K].
+
+    Each 1024-wide K group is accumulated in fp32 and the partials are summed in
+    order, as in the reference `linear`.
+    """
+    partials = k_group_partials(x, weight, out_dtype)
+    if partials.shape[0] == 1:
+        return partials[0]
+    out = torch.empty(partials.shape[1:], dtype=out_dtype, device=x.device)
+    _k_group_sum_kernel[(triton.cdiv(out.numel(), 1024),)](
+        partials, out, out.numel(), partials.shape[0], 1024
+    )
+    return out
diff --git a/vllm/models/inkling2/amd/ops/loop.py b/vllm/models/inkling2/amd/ops/loop.py
new file mode 100644
index 0000000000..ce58cb7c83
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/loop.py
@@ -0,0 +1,126 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Loop message controllers, batched over streams.
+
+A controller blends a fp32 message into a fp32 sublayer input `dest`: from
+`h = down(rms([dest, message]))` (bf16), `out = (1 - tanh(forget(h))) * dest +
+tanh(gain(h)) * message` in fp32, unfused as the reference. The output feeds
+the sublayer's RMSNorm, applied in the same kernel.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, tldevice, triton
+
+@triton.jit
+def _pair_rms_norm_kernel(
+    Dest,
+    Message,
+    Out,
+    stride_dest_s,
+    T,
+    eps,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    s = tl.program_id(0).to(tl.int64)
+    t = tl.program_id(1).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < D
+    dest = tl.load(Dest + s * stride_dest_s + t * D + cols, mask, other=0)
+    message = tl.load(Message + (s * T + t) * D + cols, mask, other=0)
+    dest_rstd = tl.rsqrt(tl.div_rn(tl.sum(dest * dest), D) + eps)
+    message_rstd = tl.rsqrt(tl.div_rn(tl.sum(message * message), D) + eps)
+    out = Out + (s * T + t) * (2 * D)
+    tl.store(out + cols, (dest * dest_rstd).to(Out.dtype.element_ty), mask)
+    tl.store(out + D + cols, (message * message_rstd).to(Out.dtype.element_ty), mask)
+
+def pair_rms_norm(dest: torch.Tensor, message: torch.Tensor) -> torch.Tensor:
+    """bf16 `(S, T, 2D)` `[rms(dest), rms(message)]` of fp32 `(S, T, D)`
+    inputs, weightless; `dest` may broadcast over streams (stride 0)."""
+    num_streams, num_tokens, d = message.shape
+    assert dest.shape == message.shape and message.is_contiguous()
+    assert dest.stride(1) == d and dest.stride(2) == 1
+    assert dest.dtype == message.dtype == torch.float32
+    out = message.new_empty((num_streams, num_tokens, 2 * d), dtype=torch.bfloat16)
+    if num_tokens:
+        _pair_rms_norm_kernel[(num_streams, num_tokens)](
+            dest,
+            message,
+            out,
+            dest.stride(0),
+            num_tokens,
+            1e-6,
+            D=d,
+            BLOCK=triton.next_power_of_2(d),
+            num_warps=8,
+        )
+    return out
+
+@triton.jit
+def _blend_rms_norm_kernel(
+    Dest,
+    Message,
+    GainForget,
+    NormW,
+    Out,
+    stride_dest_s,
+    stride_w_s,
+    T,
+    norm_eps,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    s = tl.program_id(0).to(tl.int64)
+    t = tl.program_id(1).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < D
+    row = s * T + t
+    dest = tl.load(Dest + s * stride_dest_s + t * D + cols, mask, other=0)
+    message = tl.load(Message + row * D + cols, mask, other=0)
+    gain = tldevice.tanh(tl.load(GainForget + row * (2 * D) + cols, mask, other=0))
+    forget = tldevice.tanh(
+        tl.load(GainForget + row * (2 * D) + D + cols, mask, other=0)
+    )
+    x = (1.0 - forget) * dest + gain * message
+    rstd = tl.rsqrt(tl.div_rn(tl.sum(x * x), D) + norm_eps)
+    y = x * rstd
+    y = y * tl.load(NormW + s * stride_w_s + cols, mask, other=0).to(tl.float32)
+    tl.store(Out + row * D + cols, y.to(Out.dtype.element_ty), mask)
+
+def blend_rms_norm(
+    dest: torch.Tensor,
+    message: torch.Tensor,
+    gain_forget: torch.Tensor,
+    norm_weight: torch.Tensor,
+    norm_eps: float,
+) -> torch.Tensor:
+    """bf16 `(S, T, D)` RMSNorm (row `s` of `norm_weight` `(S, D)`) of
+    `(1 - tanh(forget)) * dest + tanh(gain) * message`, with fp32 `(S, T, D)`
+    `dest` (may broadcast over streams) and `message`, and fp32 `(S, T, 2D)`
+    `gain_forget` = `[gain, forget]`. `norm_weight` may broadcast too."""
+    num_streams, num_tokens, d = message.shape
+    assert dest.shape == message.shape and message.is_contiguous()
+    assert dest.stride(1) == d and dest.stride(2) == 1
+    assert gain_forget.shape == (num_streams, num_tokens, 2 * d)
+    assert gain_forget.is_contiguous() and gain_forget.dtype == torch.float32
+    assert norm_weight.shape == (num_streams, d) and norm_weight.stride(1) == 1
+    out = message.new_empty((num_streams, num_tokens, d), dtype=torch.bfloat16)
+    if num_tokens:
+        _blend_rms_norm_kernel[(num_streams, num_tokens)](
+            dest,
+            message,
+            gain_forget,
+            norm_weight,
+            out,
+            dest.stride(0),
+            norm_weight.stride(0),
+            num_tokens,
+            norm_eps,
+            D=d,
+            BLOCK=triton.next_power_of_2(d),
+            num_warps=8,
+            # The blend is unfused (no FMA), as the reference.
+            enable_fp_fusion=False,
+        )
+    return out
diff --git a/vllm/models/inkling2/amd/ops/moe.py b/vllm/models/inkling2/amd/ops/moe.py
new file mode 100644
index 0000000000..d298397b4b
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/moe.py
@@ -0,0 +1,768 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 MoE kernels: top-k gate, the tile-padded expert row layout of the
+expert GEMMs (`triton_bmm`) with the activations quantized to MXFP8 into it,
+and the top-k combine.
+"""
+
+import math
+
+import torch
+
+from vllm.triton_utils import tl, tldevice, triton
+
+from .linear import _k_group_tile, k_group_partials
+from .mxfp8 import _mxfp8_block, _scale_offsets, _store_mxfp8_block
+from .triton_bmm import ExpertPlan
+
+
+@triton.jit
+def _sum8(x):
+    # ((x0 + x2) + (x1 + x3)) + ((x4 + x6) + (x5 + x7)) of each row of [R, 8]:
+    # the summation order of the reference renormalization kernel, so routing
+    # weights match bitwise.
+    low, high = tl.split(tl.permute(tl.reshape(x, (x.shape[0], 2, 2, 2)), (0, 1, 3, 2)))
+    low, high = tl.split(low + high)
+    low, high = tl.split(low + high)
+    return low + high
+
+
+@triton.jit
+def _selection_keys(logits, bias, experts, E: tl.constexpr):
+    """Sort keys of the experts `experts` (padding: 0): order-preserving
+    bits of sigmoid(logit) + bias in the high word and the reversed expert
+    index in the low bits, so ties prefer the lower expert index."""
+    sigmoid = tl.div_rn(1.0, 1.0 + tldevice.exp(-logits))
+    selection = sigmoid + bias
+    bits = selection.to(tl.uint32, bitcast=True)
+    bits = bits ^ tl.where((bits & 0x80000000) != 0, 0xFFFFFFFF, 0x80000000)
+    keys = (bits.to(tl.uint64) << 16) | (E - experts).to(tl.uint64)
+    return tl.where(experts < E, keys, 0)
+
+
+@triton.jit
+def _key_values(values, keys, top):
+    """`values` [R, C] where `keys` [R, C] equals each of `top` [R, K]."""
+    hit = keys[:, None, :] == top[:, :, None]
+    return tl.max(tl.where(hit, values[:, None, :], float("-inf")), 2)
+
+
+@triton.jit
+def _log_sigmoid(logits):
+    return tl.minimum(logits, 0.0) - tldevice.log1p(tldevice.exp(-tl.abs(logits)))
+
+
+@triton.jit
+def _routing_weights(log_probs, route_scale, TOPK: tl.constexpr):
+    """Renormalized sigmoid probabilities [R, TOPK] of the selected experts
+    from their log-sigmoids."""
+    max_log_probs = tl.max(log_probs, 1)
+    shifted = tldevice.exp(log_probs - max_log_probs[:, None])
+    total = _sum8(shifted) if TOPK == 8 else tl.sum(shifted, 1)
+    logsumexp = max_log_probs + tldevice.log(total)
+    return tldevice.exp(log_probs - logsumexp[:, None]) * route_scale
+
+
+@triton.jit
+def _group_sum(Partials, rows, cols, mask, T, E: tl.constexpr, GROUPS: tl.constexpr):
+    """In-order sum of the K-group partials `[GROUPS, T, E]` at `(rows,
+    cols)`."""
+    total = tl.load(Partials + rows * E + cols, mask, other=0.0, cache_modifier=".cg")
+    for group in tl.static_range(1, GROUPS):
+        total = total + tl.load(
+            Partials + (group * T + rows) * E + cols,
+            mask,
+            other=0.0,
+            cache_modifier=".cg",
+        )
+    return total
+
+
+@triton.jit
+def _load_bias(Bias, E: tl.constexpr, E_POW2: tl.constexpr):
+    """The selection bias [1, E_POW2] (padding: 0) for `_select_experts`."""
+    offs = tl.arange(0, E_POW2)[None, :]
+    return tl.load(Bias + offs, offs < E, other=0.0)
+
+
+@triton.jit
+def _top_keys(
+    Partials,
+    bias,
+    tokens,
+    T,
+    E: tl.constexpr,
+    E_POW2: tl.constexpr,
+    GROUPS: tl.constexpr,
+    TOPK: tl.constexpr,
+):
+    """The logits and `_selection_keys` [R, E_POW2] of tokens `tokens` [R]
+    and their top-k keys [R, TOPK] (`_select_experts`)."""
+    offs = tl.arange(0, E_POW2)[None, :]
+    logits = _group_sum(Partials, tokens[:, None], offs, offs < E, T, E, GROUPS)
+    keys = _selection_keys(logits, bias, offs, E)
+    return logits, keys, tl.topk(keys, TOPK)
+
+
+@triton.jit
+def _select_experts(
+    Partials,
+    bias,
+    tokens,
+    T,
+    route_scale,
+    E: tl.constexpr,
+    E_POW2: tl.constexpr,
+    GROUPS: tl.constexpr,
+    TOPK: tl.constexpr,
+    SORT: tl.constexpr,
+):
+    """Top-k ids and routing weights [R, TOPK] of tokens `tokens` [R] from
+    the K-group logit partials `[GROUPS, T, E]` and the `_load_bias`
+    `bias`, by `tl.topk` (`SORT`) or k max passes."""
+    rows = tokens[:, None]
+    offs = tl.arange(0, E_POW2)[None, :]
+    if SORT:
+        logits, keys, top = _top_keys(
+            Partials, bias, tokens, T, E, E_POW2, GROUPS, TOPK
+        )
+        ids = E - (top & 0xFFFF).to(tl.int32)
+        selected = _key_values(logits, keys, top)
+    else:
+        logits = _group_sum(Partials, rows, offs, offs < E, T, E, GROUPS)
+        keys = _selection_keys(logits, bias, offs, E)
+        # Fewer instructions than the bitonic top-k: better for large batches.
+        slots = tl.arange(0, TOPK)[None, :]
+        ids = tl.zeros((tokens.shape[0], TOPK), tl.int32)
+        for k in tl.static_range(TOPK):
+            best = tl.max(keys, 1)[:, None]
+            ids = tl.where(slots == k, E - (best & 0xFFFF).to(tl.int32), ids)
+            keys = tl.where(keys == best, 0, keys)
+        # The selected logits, summed again in the same order.
+        selected = _group_sum(Partials, rows, ids, ids >= 0, T, E, GROUPS)
+    return ids, _routing_weights(_log_sigmoid(selected), route_scale, TOPK)
+
+
+# Completion counters of the routing kernels, one 128-byte line apart.
+_ROUTERS_DONE = tl.constexpr(0)
+_TOKENS_DONE = tl.constexpr(32)
+NUM_COUNTERS = 64
+
+
+@triton.jit
+def _spin_until(Counter, value):
+    while tl.atomic_add(Counter, 0, sem="acquire") < value:
+        pass
+
+
+@triton.jit
+def _local_experts(ids, lo, hi, padding):
+    """Local index of the experts `ids` [R, TOPK] among the local experts
+    `[lo, hi)` (-1: not local, or the token is `padding`; None: none
+    is)."""
+    local = tl.where((ids >= lo) & (ids < hi), ids - lo, -1)
+    if padding is not None:
+        local = tl.where(padding[:, None], -1, local)
+    return local
+
+
+@triton.jit
+def _maximum(a, b):
+    return tl.maximum(a, b)
+
+
+@triton.jit
+def _place_experts(
+    Counts,
+    Starts,
+    Tiles,
+    NUM_LOCAL: tl.constexpr,
+    LOCAL_POW2: tl.constexpr,
+    TILE: tl.constexpr,
+    MAX_CTAS: tl.constexpr,
+):
+    """Lays out the experts' rows (`Counts`, then reset) in `TILE`-row
+    tiles: stores each expert's first layout row, first routed row and end
+    row (`Starts`) and the `Tiles` metadata."""
+    experts = tl.arange(0, LOCAL_POW2)
+    mask = experts < NUM_LOCAL
+    counts = tl.load(Counts + experts, mask, other=0, cache_modifier=".cg")
+    tiles = tl.cdiv(counts, TILE)
+    tile_ends = tl.cumsum(tiles, 0)
+    starts = (tile_ends - tiles) * TILE
+    tl.store(Starts + experts, starts, mask)
+    tl.store(Starts + LOCAL_POW2 + experts, tl.cumsum(counts, 0) - counts, mask)
+    tl.store(Starts + 2 * LOCAL_POW2 + experts, starts + counts)
+    tl.store(Counts + experts, 0, mask)
+    num_tiles = tl.max(tile_ends, 0)
+    tl.store(Tiles + 2 * MAX_CTAS, num_tiles)
+    tl.store(Tiles + 2 * MAX_CTAS + 1, num_tiles * TILE)
+    tl.store(Tiles + 2 * MAX_CTAS + 2, tl.sum(counts, 0))
+    # The expert of each tile: mark each expert's first tile, then take the
+    # running maximum. Tiles past the last are left as they are.
+    ctas = tl.arange(0, triton.next_power_of_2(MAX_CTAS))
+    tl.store(Tiles + ctas, 0, ctas < num_tiles)
+    tl.debug_barrier()
+    tl.store(Tiles + tile_ends - tiles, experts, tiles > 0)
+    tl.debug_barrier()
+    expert = tl.load(Tiles + ctas, ctas < num_tiles, cache_modifier=".cg")
+    expert = tl.associative_scan(expert, 0, _maximum)
+    end = tl.load(
+        Starts + 2 * LOCAL_POW2 + expert, ctas < num_tiles, cache_modifier=".cg"
+    )
+    tl.store(Tiles + ctas, expert, ctas < num_tiles)
+    tl.store(
+        Tiles + MAX_CTAS + ctas, tl.minimum((ctas + 1) * TILE, end), ctas < num_tiles
+    )
+
+
+@triton.jit
+def _place_rows(
+    Starts,
+    Ids,
+    Ranks,
+    Weights,
+    Src2Dst,
+    Gammas,
+    Rows,
+    token,
+    TOPK: tl.constexpr,
+    LOCAL_POW2: tl.constexpr,
+):
+    """Places a token's local rows (`_place_experts`); returns their layout
+    rows (-1: not local)."""
+    slots = token * TOPK + tl.arange(0, TOPK)
+    local = tl.load(Ids + slots)
+    rank = tl.load(Ranks + slots)
+    routed = local >= 0
+    dst = tl.where(routed, tl.load(Starts + local, routed) + rank, -1)
+    tl.store(Src2Dst + slots, dst)
+    tl.store(Gammas + dst, tl.load(Weights + slots), routed)
+    tl.store(Rows + tl.load(Starts + LOCAL_POW2 + local, routed) + rank, dst, routed)
+    return dst
+
+
+@triton.jit
+def _place_token(
+    masks,
+    mine,
+    local,
+    weights,
+    Src2Dst,
+    Gammas,
+    Rows,
+    Tiles,
+    token,
+    TOPK: tl.constexpr,
+    TILE: tl.constexpr,
+    MAX_CTAS: tl.constexpr,
+):
+    """Places the local rows of token `token` (`_place_rows`) for batches
+    of at most `TILE` tokens, whose experts take one tile each, from the
+    tokens of each local expert (`masks`, a bit per token; `mine`: those
+    of the token's experts `local`); stores the token's part of the
+    `route` outputs and returns its rows (-1: not local)."""
+    experts = tl.arange(0, masks.shape[0])
+    sizes = tldevice.popc(masks)
+    below = experts[None, :] < local[:, None]
+    tile = tl.sum((below & (masks[None, :] != 0)).to(tl.int32), 1)
+    rank = tldevice.popc(mine & ((1 << token) - 1))
+    count = tldevice.popc(mine)
+    dst = tl.where(local >= 0, tile * TILE + rank, -1)
+    slots = token * TOPK + tl.arange(0, TOPK)
+    tl.store(Src2Dst + slots, dst)
+    tl.store(Gammas + dst, weights, dst >= 0)
+    tl.store(Rows + tl.sum(tl.where(below, sizes[None, :], 0), 1) + rank, dst, dst >= 0)
+    expert_first = (rank == 0) & (local >= 0)
+    tl.store(Tiles + tile, local, expert_first)
+    tl.store(Tiles + MAX_CTAS + tile, tile * TILE + count, expert_first)
+    if token == 0:
+        num_tiles = tl.sum((masks != 0).to(tl.int32), 0)
+        tl.store(Tiles + 2 * MAX_CTAS, num_tiles)
+        tl.store(Tiles + 2 * MAX_CTAS + 1, num_tiles * TILE)
+        tl.store(Tiles + 2 * MAX_CTAS + 2, tl.sum(sizes, 0))
+    return dst
+
+
+@triton.jit
+def _pick(values, index):
+    """`values[index]` for a small vector `values` and a scalar `index`."""
+    return tl.sum(tl.where(tl.arange(0, values.shape[0]) == index, values, 0), 0)
+
+
+@triton.jit
+def _load_blocks(X, BLOCK: tl.constexpr):
+    """fp32 `X[:BLOCK]` (bf16), loaded so that each thread holds whole
+    32-column blocks."""
+    i = tl.arange(0, 4)[:, None, None]
+    b = tl.arange(0, BLOCK // 32)[None, :, None]
+    j = tl.arange(0, 8)[None, None, :]
+    x = tl.load(X + 32 * b + 8 * i + j)
+    return tl.reshape(tl.permute(x, (1, 0, 2)), (BLOCK,)).to(tl.float32)
+
+
+@triton.jit
+def _quantize_x(X, token, H: tl.constexpr, HEAD: tl.constexpr, TAIL: tl.constexpr):
+    """Quantizes row `token` of `X` (columns `[0, HEAD)` and `[HEAD,
+    HEAD + TAIL)`); returns the values and block scales of both."""
+    head = _load_blocks(X + token * H, HEAD)
+    head_values, head_scales = _mxfp8_block(tl.reshape(head, (HEAD // 32, 32)))
+    tail_values, tail_scales = head_values, head_scales
+    if TAIL > 0:
+        tail = _load_blocks(X + token * H + HEAD, TAIL)
+        tail_values, tail_scales = _mxfp8_block(tl.reshape(tail, (TAIL // 32, 32)))
+    return head_values, head_scales, tail_values, tail_scales
+
+
+@triton.jit
+def _store_rows(
+    Values,
+    Scales,
+    rows,
+    start,
+    values,
+    scales,
+    K: tl.constexpr,
+    BLOCK: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    """Stores the quantized columns `[start, start + BLOCK)` to each of
+    `rows` (negative: skipped)."""
+    valid = rows[:, None] >= 0
+    cols = start + tl.arange(0, BLOCK)
+    tl.store(
+        Values + rows[:, None] * K + cols[None, :],
+        tl.broadcast_to(tl.reshape(values, (BLOCK,))[None, :], (rows.shape[0], BLOCK)),
+        valid,
+    )
+    groups = start // 32 + tl.arange(0, BLOCK // 32)
+    tl.store(
+        Scales + _scale_offsets(rows[:, None], groups[None, :], K // 32, TILE),
+        tl.broadcast_to(scales[None, :], (rows.shape[0], BLOCK // 32)),
+        valid,
+    )
+
+
+@triton.jit
+def _store_x(
+    QValues,
+    QScales,
+    quantized,
+    dst,
+    H: tl.constexpr,
+    HEAD: tl.constexpr,
+    TAIL: tl.constexpr,
+    TILE: tl.constexpr,
+    BROADCAST: tl.constexpr,
+):
+    """Stores a `_quantize_x` row to rows `dst` (negative: skipped).
+    `BROADCAST` stores to all rows at once (lower latency); otherwise to one
+    local row after another (fewer instructions)."""
+    head_values, head_scales, tail_values, tail_scales = quantized
+    if BROADCAST:
+        rows = dst.to(tl.int64)
+        _store_rows(QValues, QScales, rows, 0, head_values, head_scales, H, HEAD, TILE)
+        if TAIL > 0:
+            _store_rows(
+                QValues, QScales, rows, HEAD, tail_values, tail_scales, H, TAIL, TILE
+            )
+    else:
+        for slot in range(dst.shape[0]):
+            row = _pick(dst, slot).to(tl.int64)
+            if row >= 0:
+                _store_mxfp8_block(
+                    QValues, QScales, row, 0, head_values, head_scales, H, HEAD, TILE
+                )
+                if TAIL > 0:
+                    _store_mxfp8_block(
+                        QValues,
+                        QScales,
+                        row,
+                        HEAD,
+                        tail_values,
+                        tail_scales,
+                        H,
+                        TAIL,
+                        TILE,
+                    )
+
+
+# Batches up to this many tokens route and quantize in one launch.
+FUSED_ROUTING_MAX_TOKENS = 16
+
+
+@triton.jit
+def _fused_route_kernel(
+    X,
+    GateWeight,
+    Bias,
+    Partials,
+    ExpertBounds,
+    Padding,
+    Counters,
+    Masks,
+    Src2Dst,
+    Gammas,
+    Rows,
+    Tiles,
+    QValues,
+    QScales,
+    T,
+    route_scale,
+    H: tl.constexpr,
+    E: tl.constexpr,
+    E_POW2: tl.constexpr,
+    GROUPS: tl.constexpr,
+    TOPK: tl.constexpr,
+    NUM_LOCAL: tl.constexpr,
+    LOCAL_POW2: tl.constexpr,
+    TILE: tl.constexpr,
+    MAX_CTAS: tl.constexpr,
+    HEAD: tl.constexpr,
+    TAIL: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+):
+    # Programs [0, ROUTERS) compute the router K-group partials. Program
+    # ROUTERS + t quantizes token t meanwhile, waits for them, selects the
+    # token's experts and marks it in the token mask of each of its local
+    # experts (``Masks``; a single token needs no masks); once all tokens are
+    # marked, it stores the token into its place.
+    pid = tl.program_id(0)
+    N_TILES: tl.constexpr = (E + BN - 1) // BN
+    ROUTERS: tl.constexpr = N_TILES * GROUPS
+    bias = _load_bias(Bias, E, E_POW2)
+    lo = tl.load(ExpertBounds)
+    hi = tl.load(ExpertBounds + 1)
+    if pid < ROUTERS:
+        _k_group_tile(
+            X,
+            GateWeight,
+            Partials,
+            T,
+            E,
+            H,
+            BM,
+            BN,
+            True,
+            pid % N_TILES,
+            0,
+            pid // N_TILES,
+        )
+        tl.debug_barrier()
+        tl.atomic_add(Counters + _ROUTERS_DONE, 1, sem="release")
+    else:
+        token = pid - ROUTERS
+        tokens = tl.full((1,), token, tl.int64)
+        padding = None
+        if Padding is not None:
+            padding = tl.load(Padding + tokens)
+        quantized = _quantize_x(X, token.to(tl.int64), H, HEAD, TAIL)
+        _spin_until(Counters + _ROUTERS_DONE, ROUTERS)
+        logits, keys, top = _top_keys(
+            Partials, bias, tokens, T, E, E_POW2, GROUPS, TOPK
+        )
+        ids = E - (top & 0xFFFF).to(tl.int32)
+        local = tl.reshape(_local_experts(ids, lo, hi, padding), (TOPK,))
+        experts = tl.arange(0, LOCAL_POW2)
+        if T > 1:
+            tl.atomic_or(Masks + local, 1 << token, local >= 0, sem="relaxed")
+            tl.debug_barrier()
+            tl.atomic_add(Counters + _TOKENS_DONE, 1, sem="release")
+        # The routing weights, while the other tokens are marked.
+        weights = _routing_weights(
+            _log_sigmoid(_key_values(logits, keys, top)), route_scale, TOPK
+        )
+        if T > 1:
+            _spin_until(Counters + _TOKENS_DONE, T)
+            masks = tl.load(
+                Masks + experts, experts < NUM_LOCAL, other=0, cache_modifier=".cg"
+            )
+            mine = tl.load(Masks + local, local >= 0, other=0, cache_modifier=".cg")
+        else:
+            masks = tl.max((experts[:, None] == local[None, :]).to(tl.int32), 1)
+            mine = (local >= 0).to(tl.int32)
+        dst = _place_token(
+            masks,
+            mine,
+            local,
+            tl.reshape(weights, (TOPK,)),
+            Src2Dst,
+            Gammas,
+            Rows,
+            Tiles,
+            token,
+            TOPK,
+            TILE,
+            MAX_CTAS,
+        )
+        # The last program to get here resets the masks and counters: the
+        # others have used them (the barrier follows the stores of the
+        # placement).
+        last = T == 1
+        if T > 1:
+            tl.debug_barrier()
+            last = tl.atomic_add(Counters + _TOKENS_DONE, 1, sem="relaxed") == 2 * T - 1
+        _store_x(QValues, QScales, quantized, dst, H, HEAD, TAIL, TILE, True)
+        if last:
+            if T > 1:
+                tl.store(Masks + experts, 0, experts < NUM_LOCAL)
+            tl.store(Counters + _ROUTERS_DONE, 0)
+            tl.store(Counters + _TOKENS_DONE, 0)
+
+
+@triton.jit
+def _route_tokens_kernel(
+    Partials,
+    Bias,
+    ExpertBounds,
+    Padding,
+    Counts,
+    Counters,
+    Ids,
+    Ranks,
+    Weights,
+    Starts,
+    Tiles,
+    T,
+    route_scale,
+    E: tl.constexpr,
+    E_POW2: tl.constexpr,
+    GROUPS: tl.constexpr,
+    TOPK: tl.constexpr,
+    SORT: tl.constexpr,
+    NUM_LOCAL: tl.constexpr,
+    LOCAL_POW2: tl.constexpr,
+    TILE: tl.constexpr,
+    MAX_CTAS: tl.constexpr,
+):
+    # Selects a token's experts (stores their local index, -1: not local or
+    # padding) and ranks its local rows within their experts (in ``Counts``,
+    # zeroed beforehand). The last program to finish lays out the experts'
+    # rows.
+    bias = _load_bias(Bias, E, E_POW2)
+    lo = tl.load(ExpertBounds)
+    hi = tl.load(ExpertBounds + 1)
+    token = tl.full((1,), tl.program_id(0), tl.int64)
+    padding = None
+    if Padding is not None:
+        padding = tl.load(Padding + token)
+    ids, weights = _select_experts(
+        Partials, bias, token, T, route_scale, E, E_POW2, GROUPS, TOPK, SORT
+    )
+    local = _local_experts(ids, lo, hi, padding)
+    slots = token[:, None] * TOPK + tl.arange(0, TOPK)[None, :]
+    rank = tl.atomic_add(Counts + local, 1, mask=local >= 0, sem="relaxed")
+    tl.store(Ranks + slots, rank)
+    tl.store(Ids + slots, local)
+    tl.store(Weights + slots, weights)
+    tl.debug_barrier()
+    if tl.atomic_add(Counters + _TOKENS_DONE, 1, sem="acq_rel") == T - 1:
+        _place_experts(Counts, Starts, Tiles, NUM_LOCAL, LOCAL_POW2, TILE, MAX_CTAS)
+        tl.store(Counters + _TOKENS_DONE, 0)
+
+
+@triton.jit
+def _scatter_kernel(
+    X,
+    Starts,
+    Ids,
+    Ranks,
+    Weights,
+    Src2Dst,
+    Gammas,
+    Rows,
+    QValues,
+    QScales,
+    H: tl.constexpr,
+    TOPK: tl.constexpr,
+    LOCAL_POW2: tl.constexpr,
+    TILE: tl.constexpr,
+    HEAD: tl.constexpr,
+    TAIL: tl.constexpr,
+    BROADCAST: tl.constexpr,
+):
+    token = tl.program_id(0).to(tl.int64)
+    quantized = _quantize_x(X, token, H, HEAD, TAIL)
+    dst = _place_rows(
+        Starts, Ids, Ranks, Weights, Src2Dst, Gammas, Rows, token, TOPK, LOCAL_POW2
+    )
+    _store_x(QValues, QScales, quantized, dst, H, HEAD, TAIL, TILE, BROADCAST)
+
+
+def route(
+    x: torch.Tensor,
+    gate_weight: torch.Tensor,
+    bias: torch.Tensor,
+    counters: torch.Tensor,
+    counts: torch.Tensor,
+    topk: int,
+    route_scale: float,
+    expert_bounds: torch.Tensor,
+    plan: ExpertPlan,
+    is_padding: torch.Tensor | None = None,
+) -> tuple[
+    tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor],
+    tuple[torch.Tensor, torch.Tensor],
+]:
+    """Router, top-k and the tile-padded layout of the rows of the local
+    experts `expert_bounds`, with `x` quantized to MXFP8 into it.
+
+    Returns `(src2dst, gammas, rows, tiles)`: the layout row of each flat
+    (token * topk + slot) row (-1: not local), the routing weight of each
+    layout row, the routed layout rows in expert order and the `tiles`
+    metadata of `triton_bmm.bmm` followed by the number of routed rows; and
+    the quantized rows and their block scales. `counters` (`NUM_COUNTERS`)
+    and `counts` (one per local expert) are zeroed int32s that the kernels
+    reset. Tokens marked in the bool `is_padding` have no local rows on any
+    rank: their `src2dst` is -1, so they combine to 0.
+    """
+    tokens, hidden = x.shape
+    assert is_padding is None or (
+        is_padding.shape == (tokens,) and is_padding.dtype == torch.bool
+    )
+    experts = gate_weight.shape[0]
+    assert x.is_contiguous() and gate_weight.is_contiguous()
+    num_local = counts.numel()
+    n = tokens * topk
+    device = x.device
+    rows = plan.rows
+    src2dst = torch.empty(n, dtype=torch.int32, device=device)
+    gammas = torch.empty(rows, dtype=torch.float32, device=device)
+    routed = torch.empty(n, dtype=torch.int32, device=device)
+    tiles = torch.empty(2 * plan.max_ctas + 3, dtype=torch.int32, device=device)
+    ids = torch.empty(n, dtype=torch.int32, device=device)
+    ranks = torch.empty(n, dtype=torch.int32, device=device)
+    weights = torch.empty(n, dtype=torch.float32, device=device)
+    quantized = (
+        torch.empty((rows, hidden), dtype=torch.float8_e4m3fn, device=device),
+        torch.empty((rows, hidden // 32), dtype=torch.uint8, device=device),
+    )
+    outputs = (src2dst, gammas, routed, tiles)
+    # Rows are quantized in a power-of-two head and tail.
+    head = 1 << (hidden.bit_length() - 1)
+    tail = hidden - head
+    assert tail & (tail - 1) == 0 and (tail == 0 or tail >= 32)
+    if tokens <= FUSED_ROUTING_MAX_TOKENS:
+        assert plan.tile >= tokens
+        groups = triton.cdiv(hidden, 1024)
+        block_n = 32
+        partials = torch.empty(
+            (groups, tokens, experts), dtype=torch.float32, device=device
+        )
+        routers = triton.cdiv(experts, block_n) * groups
+        # Token programs wait for the router programs: launch all co-resident.
+        _fused_route_kernel[(routers + tokens,)](
+            x,
+            gate_weight,
+            bias,
+            partials,
+            expert_bounds,
+            is_padding,
+            counters,
+            counts,
+            *outputs,
+            *quantized,
+            tokens,
+            route_scale,
+            H=hidden,
+            E=experts,
+            E_POW2=triton.next_power_of_2(experts),
+            GROUPS=groups,
+            HEAD=head,
+            TAIL=tail,
+            BM=16,
+            BN=block_n,
+            TOPK=topk,
+            NUM_LOCAL=num_local,
+            LOCAL_POW2=triton.next_power_of_2(num_local),
+            TILE=plan.tile,
+            MAX_CTAS=plan.max_ctas,
+            num_warps=4,
+            num_stages=4,
+            enable_fp_fusion=False,
+            launch_cooperative_grid=True,
+        )
+        return outputs, quantized
+
+    partials = k_group_partials(x, gate_weight)
+    local_pow2 = triton.next_power_of_2(num_local)
+    starts = torch.empty(3 * local_pow2, dtype=torch.int32, device=device)
+    _route_tokens_kernel[(tokens,)](
+        partials,
+        bias,
+        expert_bounds,
+        is_padding,
+        counts,
+        counters,
+        ids,
+        ranks,
+        weights,
+        starts,
+        tiles,
+        tokens,
+        route_scale,
+        E=experts,
+        E_POW2=triton.next_power_of_2(experts),
+        GROUPS=partials.shape[0],
+        TOPK=topk,
+        SORT=tokens <= 128,
+        NUM_LOCAL=num_local,
+        LOCAL_POW2=local_pow2,
+        TILE=plan.tile,
+        MAX_CTAS=plan.max_ctas,
+        num_warps=4 if tokens <= 128 else 1,
+    )
+    _scatter_kernel[(tokens,)](
+        x,
+        starts,
+        ids,
+        ranks,
+        weights,
+        src2dst,
+        gammas,
+        routed,
+        *quantized,
+        H=hidden,
+        TOPK=topk,
+        LOCAL_POW2=local_pow2,
+        TILE=plan.tile,
+        HEAD=head,
+        TAIL=tail,
+        BROADCAST=tokens < 512,
+        num_warps=2,
+        enable_fp_fusion=False,
+    )
+    return outputs, quantized
+
+
+@triton.jit
+def _combine_kernel(
+    Down, Src2Dst, Out, H: tl.constexpr, TOPK: tl.constexpr, BLOCK: tl.constexpr
+):
+    token = tl.program_id(0).to(tl.int64)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.zeros((BLOCK,), tl.float32)
+    for slot in tl.static_range(TOPK):
+        row = tl.load(Src2Dst + token * TOPK + slot).to(tl.int64)
+        acc += tl.load(Down + row * H + cols, row >= 0, other=0).to(tl.float32)
+    tl.store(Out + token * H + cols, acc)
+
+
+def combine(
+    down: torch.Tensor,
+    src2dst: torch.Tensor,
+    topk: int,
+    out_dtype: torch.dtype,
+) -> torch.Tensor:
+    """Sum each token's rows of `down` (rows -1 count 0)."""
+    tokens = src2dst.numel() // topk
+    hidden = down.shape[1]
+    # The widest power-of-two column block that tiles the hidden width.
+    block = math.gcd(hidden, 512)
+    assert block >= 64
+    out = torch.empty((tokens, hidden), dtype=out_dtype, device=down.device)
+    _combine_kernel[(tokens, hidden // block)](
+        down, src2dst, out, hidden, topk, block, num_warps=2
+    )
+    return out
diff --git a/vllm/models/inkling2/amd/ops/mxfp4.py b/vllm/models/inkling2/amd/ops/mxfp4.py
new file mode 100644
index 0000000000..a891f6d30b
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/mxfp4.py
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MXFP4 expert weights (OCP e2m1 values, two per byte, low nibble first; ue8m0
+scales per 32 elements) from the checkpoint's NVFP4 ones.
+
+NVFP4 stores `w = e2m1 * scale * (amax / denominator)`: an e4m3 `scale` per
+16 elements and one `amax` per expert. The RDNA4 GEMMs take power-of-two
+block scales, so the weights are dequantized and requantized once, after
+loading. The step is lossy (32-wide power-of-two blocks are coarser than
+16-wide e4m3 ones); `requantize_nvfp4` returns the relative error it made.
+"""
+
+import torch
+
+E2M1_VALUES = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+E8M0_BIAS = 127
+
+
+def e2m1_lut(device: torch.device) -> torch.Tensor:
+    """fp32 values of the 16 e2m1 codes (bit 3 is the sign)."""
+    positive = torch.tensor(E2M1_VALUES, dtype=torch.float32, device=device)
+    return torch.cat((positive, -positive))
+
+
+def unpack_e2m1(packed: torch.Tensor) -> torch.Tensor:
+    """uint8 `[..., K / 2]` -> fp32 `[..., K]` (low nibble = even index)."""
+    codes = torch.stack((packed & 0xF, packed >> 4), dim=-1).flatten(-2)
+    return e2m1_lut(packed.device)[codes.long()]
+
+
+def dequantize_nvfp4(
+    packed: torch.Tensor, scale: torch.Tensor, outer_scale: torch.Tensor
+) -> torch.Tensor:
+    """fp32 `[E, N, K]` weights of NVFP4 `packed` `[E, N, K / 2]`, e4m3
+    `scale` `[E, N, K / 16]` and fp32 `outer_scale` `[E]`."""
+    values = unpack_e2m1(packed)
+    block = scale.float().repeat_interleave(16, dim=-1)
+    return values * block * outer_scale.view(-1, 1, 1)
+
+
+def _quantize_e2m1(x: torch.Tensor) -> torch.Tensor:
+    """Round fp32 `x` (already divided by its block scale) to the nearest
+    e2m1 value, ties to even mantissa; returns the 4-bit codes (uint8)."""
+    magnitude = x.abs().clamp_(max=6.0)
+    # Spacing is 0.5 up to 2, 1 up to 4, 2 up to 6.
+    step = torch.where(magnitude < 2.0, 0.5, torch.where(magnitude < 4.0, 1.0, 2.0))
+    rounded = torch.round(magnitude / step) * step
+    # Code = index of the value in E2M1_VALUES.
+    code = torch.where(
+        rounded <= 2.0,
+        rounded * 2.0,
+        torch.where(rounded <= 4.0, rounded + 2.0, rounded * 0.5 + 4.0),
+    ).to(torch.uint8)
+    return code | (torch.signbit(x).to(torch.uint8) << 3)
+
+
+def quantize_mxfp4(w: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """fp32 `[..., K]` (K a multiple of 32) -> packed e2m1 uint8
+    `[..., K / 2]` and ue8m0 exponents uint8 `[..., K / 32]`.
+
+    Per block the exponent is the one of `ceil(log2(amax / 6))` (no value
+    clips) and the one below it (the top of the block clips, the rest gains a
+    bit) with the smaller squared error."""
+    shape = w.shape
+    blocks = w.reshape(*shape[:-1], shape[-1] // 32, 32)
+    amax = blocks.abs().amax(dim=-1, keepdim=True)
+    noclip = torch.ceil(torch.log2(amax.clamp_min(2.0**-120) / 6.0))
+    best_codes = best_err = best_exp = None
+    for exponent in (noclip, noclip - 1.0):
+        exponent = exponent.clamp(-E8M0_BIAS, E8M0_BIAS)
+        scale = torch.exp2(exponent)
+        codes = _quantize_e2m1(blocks / scale)
+        err = (e2m1_lut(w.device)[codes.long()] * scale - blocks).square().sum(-1, True)
+        if best_err is None:
+            best_codes, best_err, best_exp = codes, err, exponent
+        else:
+            better = err < best_err
+            best_codes = torch.where(better, codes, best_codes)
+            best_exp = torch.where(better, exponent, best_exp)
+    assert best_codes is not None and best_exp is not None
+    codes = best_codes.reshape(*shape[:-1], shape[-1] // 2, 2)
+    packed = codes[..., 0] | (codes[..., 1] << 4)
+    exponents = (best_exp.squeeze(-1) + E8M0_BIAS).to(torch.uint8)
+    return packed.contiguous(), exponents.contiguous()
+
+
+def dequantize_mxfp4(packed: torch.Tensor, exponents: torch.Tensor) -> torch.Tensor:
+    """fp32 `[..., K]` of packed e2m1 `[..., K / 2]` and ue8m0 exponents
+    `[..., K / 32]` (the reference of the GEMM)."""
+    scale = torch.exp2(exponents.float() - E8M0_BIAS).repeat_interleave(32, dim=-1)
+    return unpack_e2m1(packed) * scale
+
+
+def requantize_nvfp4(
+    packed: torch.Tensor, scale: torch.Tensor, outer_scale: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor, float]:
+    """NVFP4 expert weights -> MXFP4 `(packed, exponents)` and the relative
+    Frobenius error of the requantization, one expert at a time."""
+    out_packed = torch.empty_like(packed)
+    exponents = torch.empty(
+        (*packed.shape[:-1], packed.shape[-1] // 16), dtype=torch.uint8, device=packed.device
+    )
+    err = norm = 0.0
+    for e in range(packed.shape[0]):
+        w = dequantize_nvfp4(packed[e : e + 1], scale[e : e + 1], outer_scale[e : e + 1])
+        out_packed[e : e + 1], exponents[e : e + 1] = quantize_mxfp4(w)
+        back = dequantize_mxfp4(out_packed[e : e + 1], exponents[e : e + 1])
+        err += (back - w).square().sum().item()
+        norm += w.square().sum().item()
+    return out_packed, exponents, (err / max(norm, 1e-30)) ** 0.5
diff --git a/vllm/models/inkling2/amd/ops/mxfp8.py b/vllm/models/inkling2/amd/ops/mxfp8.py
new file mode 100644
index 0000000000..de3624c429
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/mxfp8.py
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MXFP8 (e4m3 values, ue8m0 scales per 32 elements) activation quantization.
+
+Activations of the expert GEMMs (`triton_bmm`) store their block scales in
+tiles of 4 columns and 128 rows (R128c4, for token tiles of 128 rows and
+more) or 8 rows (R8c4), so a GEMM tile reads its scales in 512- or 32-byte
+runs: scale `(r, c)` lives at `[r // 128, c // 4, r % 32, r % 128 // 32,
+c % 4]` or `[r // 8, c // 4, r % 8, c % 4]`.
+"""
+
+import math
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _scale_offsets(row, cols, COLS: tl.constexpr, TILE: tl.constexpr):
+    """Offsets of scales `(row, cols)` of a `COLS`-column scale matrix for
+    GEMM token tiles of `TILE` rows (0: row-major)."""
+    if TILE >= 128:
+        tile = (row // 128) * (COLS // 4) + cols // 4
+        return tile * 512 + (row % 32) * 16 + (row // 32 % 4) * 4 + cols % 4
+    if TILE > 0:
+        tile = (row // 8) * (COLS // 4) + cols // 4
+        return tile * 32 + (row % 8) * 4 + cols % 4
+    return row * COLS + cols
+
+
+@triton.jit
+def _mxfp8_block(groups):
+    amax = tl.max(tl.abs(groups), 1)
+    raw_scale = amax * (1.0 / 448.0)
+    min_scale = tl.full((), 2.0**-127, tl.float32)
+    exponent = ((raw_scale.to(tl.int32, bitcast=True) + 0x007FFFFF) & 0x7F800000) >> 23
+    exponent = tl.where(raw_scale <= min_scale, 0, tl.minimum(exponent, 254))
+    exponent = tl.where(raw_scale != raw_scale, 255, exponent)
+    scale = tl.maximum((exponent << 23).to(tl.float32, bitcast=True), min_scale)
+    scale = tl.where(exponent == 255, float("nan"), scale)
+    inverse = tl.where(exponent == 0, 2.0**127, tl.div_rn(1.0, scale))
+    inverse = tl.where(exponent == 255, 0.0, inverse)
+    values = groups * inverse[:, None]
+    values = tl.minimum(
+        tl.maximum(values, -448.0), 448.0, propagate_nan=tl.PropagateNan.ALL
+    )
+    return values.to(tl.float8e4nv), exponent
+
+
+@triton.jit
+def _store_mxfp8_block(
+    Values,
+    Scales,
+    row,
+    start,
+    values,
+    exponent,
+    N: tl.constexpr,
+    BLOCK: tl.constexpr,
+    TILE: tl.constexpr,
+):
+    # Stores the block at column ``start`` of output row ``row``.
+    groups = start // 32 + tl.arange(0, BLOCK // 32)
+    tl.store(Scales + _scale_offsets(row, groups, N // 32, TILE), exponent)
+    cols = start + tl.arange(0, BLOCK)
+    tl.store(Values + row * N + cols, tl.reshape(values, (BLOCK,)))
+
+
+@triton.jit
+def _mxfp8_quantize_kernel(X, Y, S, M, N: tl.constexpr, BLOCK: tl.constexpr):
+    for r in range(tl.program_id(0), M, tl.num_programs(0)):
+        row = tl.cast(r, tl.int64)
+        cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+        x = tl.load(X + row * N + cols, cols < N, other=0).to(tl.float32)
+        values, exponent = _mxfp8_block(tl.reshape(x, (BLOCK // 32, 32)))
+        _store_mxfp8_block(
+            Y, S, row, tl.program_id(1) * BLOCK, values, exponent, N, BLOCK, 0
+        )
+
+
+def mxfp8_quantize(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize rows of bf16 `x` [M, N] to MXFP8 with round-up power-of-two scales.
+
+    Returns e4m3 values and row-major ue8m0 scale exponents [M, N/32].
+    """
+    assert x.ndim == 2 and x.is_contiguous() and x.shape[1] % 32 == 0
+    rows, n = x.shape
+    values = torch.empty((rows, n), dtype=torch.float8_e4m3fn, device=x.device)
+    scales = torch.empty((rows, n // 32), dtype=torch.uint8, device=x.device)
+    block = math.gcd(n, 1024)
+    _mxfp8_quantize_kernel[(min(rows, 8192), n // block)](
+        x,
+        values,
+        scales,
+        rows,
+        N=n,
+        BLOCK=block,
+        enable_fp_fusion=False,
+    )
+    return values, scales
diff --git a/vllm/models/inkling2/amd/ops/norm.py b/vllm/models/inkling2/amd/ops/norm.py
new file mode 100644
index 0000000000..a0221df5f3
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/norm.py
@@ -0,0 +1,182 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 row-wise kernels: RMSNorm and the q/r L2 clipping (fused into the
+attention prologue in `ops/sconv.py`).
+
+All math is fp32; each output is rounded once to its storage dtype.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _rms_norm_kernel(
+    X,
+    W,
+    Y,
+    stride_x,
+    N: tl.constexpr,
+    eps,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < N
+    x = tl.load(X + row * stride_x + cols, mask, other=0).to(tl.float32)
+    rstd = tl.rsqrt(tl.div_rn(tl.sum(x * x), N) + eps)
+    y = x * rstd
+    y = y * tl.load(W + cols, mask, other=0).to(tl.float32)
+    tl.store(Y + row * N + cols, y.to(Y.dtype.element_ty), mask)
+
+
+def rms_norm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    out_dtype: torch.dtype | None = None,
+) -> torch.Tensor:
+    """RMSNorm over the last dim of a row-major (possibly row-strided) tensor."""
+    n = x.shape[-1]
+    assert x.stride(-1) == 1
+    x2d = x if x.dim() == 2 else x.reshape(-1, n)
+    out = torch.empty(x.shape, dtype=out_dtype or x.dtype, device=x.device)
+    if x2d.shape[0]:
+        block = triton.next_power_of_2(n)
+        _rms_norm_kernel[(x2d.shape[0],)](
+            x2d,
+            weight,
+            out,
+            x2d.stride(0),
+            n,
+            eps,
+            BLOCK=block,
+            num_warps=min(max(block // 512, 1), 16),
+        )
+    return out
+
+
+def fused_add_rms_norm(
+    x: torch.Tensor, residual: torch.Tensor, weight: torch.Tensor, eps: float
+) -> None:
+    """In place: `residual += x; x = rms_norm(residual)`, normalizing the
+    unrounded fp32 sum (as flashinfer's `fused_add_rmsnorm`)."""
+    total = x.float() + residual
+    residual.copy_(total)
+    x.copy_(rms_norm(total, weight, eps, x.dtype))
+
+
+@triton.jit
+def _l2_clip(X, Scale, heads, cols, mask, threshold, eps, tau, HAS_TAU):
+    x = tl.load(X + heads * cols.shape[1] + cols, mask, other=0).to(tl.float32)
+    x = x * tl.load(Scale + heads * cols.shape[1] + cols, mask, other=0).to(tl.float32)
+    sum_sq = tl.sum(x * x, axis=1)
+    norm = tl.where(sum_sq > 0, sum_sq * tl.rsqrt(sum_sq), 0.0)
+    y = x * tl.minimum(tl.div_rn(threshold, norm + eps), 1.0)[:, None]
+    if HAS_TAU:
+        y = y.to(X.dtype.element_ty).to(tl.float32) * tau
+    return y.to(X.dtype.element_ty)
+
+
+@triton.jit
+def qr_clip_rel_tokens(
+    t0,
+    num_t: tl.constexpr,
+    chunk,
+    T,
+    Q,
+    R,
+    QScale,
+    RScale,
+    Tau,
+    RelProj,
+    QOut,
+    RelOut,
+    SeqIdx,
+    CuSeqlensQ,
+    SeqLens,
+    stride_q,
+    stride_r,
+    q_threshold,
+    r_threshold,
+    eps,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    D_REL: tl.constexpr,
+    E: tl.constexpr,
+    W: tl.constexpr,
+    HAS_TAU: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_E: tl.constexpr,
+):
+    """For tokens `[t0, t0 + num_t)`: per-head L2 clipping of `q * q_scale`
+    (`chunk < 0`) or of `r * r_scale` and the `BLOCK_E` columns `chunk`
+    of the relative logits `r @ rel_proj` (fp32 accumulate; `rel_proj`
+    read from the `shift_rel_proj` table `RelProj`). Clipped values are
+    rounded, then scaled by the fp32 per-token `tau`.
+
+    The logits are written sheared for `rel_attention`'s 128-token query
+    tiles: `E + 256` columns per head, column `c` holding
+    key `c + (n_block_max - 10) * 128`, where `n_block_max` bounds the key
+    blocks of the token's tile, plus the table's padding (keys right of the
+    diagonal, and for window layers those past the extent, are -inf)."""
+    E_PAD: tl.constexpr = E + 256
+    heads = tl.arange(0, BLOCK_H)[:, None]
+    h_mask = heads < H
+    q_cols = tl.arange(0, D)[None, :]
+    r_cols = tl.arange(0, D_REL)[None, :]
+    e_idx = tl.arange(0, BLOCK_E)[None, :]
+    for i in tl.static_range(num_t):
+        t = (t0 + i).to(tl.int64)
+        if t < T and chunk < 0:
+            tau = tl.load(Tau + t) if HAS_TAU else 1.0
+            q = _l2_clip(
+                Q + t * stride_q,
+                QScale,
+                heads,
+                q_cols,
+                h_mask,
+                q_threshold,
+                eps,
+                tau,
+                HAS_TAU,
+            )
+            tl.store(QOut + t * H * D + heads * D + q_cols, q, h_mask)
+        elif t < T:
+            seq = tl.load(SeqIdx + t)
+            q_start = tl.load(CuSeqlensQ + seq)
+            q_len = tl.load(CuSeqlensQ + seq + 1) - q_start
+            q_idx = t - q_start
+            pos = tl.load(SeqLens + seq) - q_len + q_idx
+            tile_end = tl.minimum((q_idx // 128 + 1) * 128, q_len)
+            # Column of the diagonal key (distance 0), in [E + 1, E + 255] for a
+            # real token. CUDA-graph padding rows (seq_idx 0, q_idx past the
+            # request) would land outside and read before the shifted table.
+            diag = pos + E_PAD - tl.cdiv(pos - q_idx + tile_end, 128) * 128
+            diag = tl.minimum(tl.maximum(diag, E + 1), E_PAD - 1)
+            tau = tl.load(Tau + t) if HAS_TAU else 1.0
+            r = _l2_clip(
+                R + t * stride_r,
+                RScale,
+                heads,
+                r_cols,
+                h_mask,
+                r_threshold,
+                eps,
+                tau,
+                HAS_TAU,
+            )
+            # Distance diag - c of column c is column (c - diag8 + E + 256) of
+            # shifted table diag - diag8: 16-byte aligned loads.
+            diag8 = diag // 8 * 8
+            table = RelProj + (diag - diag8) * (D_REL + 1) * W + E + 256 - diag8
+            col = chunk * BLOCK_E + e_idx
+            proj = tl.load(table + tl.trans(r_cols) * W + col)
+            pad = tl.load(table + D_REL * W + col)
+            rel = tl.dot(r, proj) + pad.to(tl.float32)
+            tl.store(
+                RelOut + t * H * E_PAD + heads * E_PAD + col,
+                rel.to(RelOut.dtype.element_ty),
+                h_mask,
+            )
diff --git a/vllm/models/inkling2/amd/ops/sconv.py b/vllm/models/inkling2/amd/ops/sconv.py
new file mode 100644
index 0000000000..20cd111722
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/sconv.py
@@ -0,0 +1,888 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 short convolution over a paged sliding-window conv-state cache.
+
+The cache (`[num_blocks, H, N, D]`, see `InklingConvState` in
+`vllm/models/inkling2/sconv.py`) stores each stream's conv input at every
+absolute position. Per token, one launch writes the current input to its slot
+and convolves the `W` taps ending at its position: taps inside this forward
+are read from `x`, earlier taps from the paged cache, and taps before
+position 0 are zero.
+
+Static convolution (fp32 accumulate, oldest tap first)::
+
+    y = (sum_k w[c, k] * x[t - (W - 1) + k] + x[t]) * (W + 1) ** -0.5
+
+Dynamic convolution (newest tap first, per-token per-head tap weights)::
+
+    y = (sum_l (static_w[l, c] + dyn[t, head(c), l]) * x[t - l] + x[t])
+        * (2 * W + 1) ** -0.5
+
+`y` is rounded to the input dtype. The K/V variant then L2-clips K and
+RMS-normalizes V per head and writes both to the paged KV cache.
+"""
+
+import torch
+
+from vllm.models.inkling2.amd.ops.norm import qr_clip_rel_tokens
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _cached_taps(
+    cache_ptr,
+    cache_col,
+    stride_c_blk,
+    stride_c_n,
+    N,
+    c_mask,
+    block_table_ptr,
+    stride_bt,
+    max_blocks,
+    req,
+    src,
+    cached,
+):
+    safe_src = tl.maximum(src, 0)
+    lblk = tl.minimum(safe_src // N, max_blocks - 1)
+    blk = tl.load(block_table_ptr + req * stride_bt + lblk, mask=cached, other=0)
+    return tl.load(
+        cache_ptr
+        + blk.to(tl.int64)[:, None] * stride_c_blk
+        + (safe_src % N)[:, None] * stride_c_n
+        + cache_col[None, :],
+        mask=c_mask[None, :] & cached[:, None],
+        other=0.0,
+    ).to(tl.float32)
+
+
+@triton.jit
+def _cached_tap(
+    cache_ptr,
+    cache_col,
+    stride_c_blk,
+    stride_c_n,
+    N,
+    c_mask,
+    block_table_ptr,
+    stride_bt,
+    max_blocks,
+    req,
+    pos,
+    toff,
+    qstart,
+    valid,
+    lag: tl.constexpr,
+):
+    src = pos - lag
+    cached = valid & (src >= 0) & (toff - lag < qstart)
+    return _cached_taps(
+        cache_ptr,
+        cache_col,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        c_mask,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        req,
+        src,
+        cached,
+    )
+
+
+@triton.jit
+def _tap_sum(
+    x_ptr,
+    stride_x,
+    cache_ptr,
+    cache_col,
+    stride_c_blk,
+    stride_c_n,
+    N,
+    weight_ptr,
+    stride_w0,
+    stride_w1,
+    block_table_ptr,
+    stride_bt,
+    max_blocks,
+    toff,
+    coff,
+    c_mask,
+    tc_mask,
+    pos,
+    req,
+    qstart,
+    valid,
+    cur,
+    W: tl.constexpr,
+    dyn_ptr,
+    stride_dyn,
+    HEAD_DIM: tl.constexpr,
+    preloaded=None,
+    READ_CACHE: tl.constexpr = False,
+):
+    """Weighted sum of the W taps; earlier steps' taps come from
+    `preloaded` or, with READ_CACHE, from the cache (else they are zero)."""
+    dtype = cache_ptr.dtype.element_ty
+    acc = tl.zeros(cur.shape, dtype=tl.float32)
+    for k in tl.static_range(W):
+        lag = k if dyn_ptr is not None else W - 1 - k
+        src = pos - lag
+        row = toff - lag
+        in_win = valid & (src >= 0)
+        intra = in_win & (row >= qstart)
+        cached = in_win & (row < qstart)
+        xt = (
+            tl.load(
+                x_ptr + tl.maximum(row, 0)[:, None] * stride_x + coff[None, :],
+                mask=c_mask[None, :] & intra[:, None],
+                other=0.0,
+            )
+            .to(dtype)
+            .to(tl.float32)
+        )
+        if preloaded is not None:
+            xt += preloaded[k]
+        elif READ_CACHE:
+            xt += _cached_taps(
+                cache_ptr,
+                cache_col,
+                stride_c_blk,
+                stride_c_n,
+                N,
+                c_mask,
+                block_table_ptr,
+                stride_bt,
+                max_blocks,
+                req,
+                src,
+                cached,
+            )
+        value = xt
+        if dyn_ptr is not None:
+            w = tl.load(
+                weight_ptr + lag * stride_w0 + coff * stride_w1, mask=c_mask, other=0
+            ).to(tl.float32)
+            dyn = tl.load(
+                dyn_ptr
+                + toff[:, None] * stride_dyn
+                + (coff // HEAD_DIM)[None, :] * W
+                + lag,
+                mask=tc_mask,
+                other=0,
+            ).to(tl.float32)
+            w = w[None, :] + dyn
+        else:
+            w = tl.load(
+                weight_ptr + coff * stride_w0 + k * stride_w1, mask=c_mask, other=0
+            )
+            w = w.to(dtype).to(tl.float32)[None, :]
+        acc = value * w if dyn_ptr is not None and k == 0 else tl.fma(value, w, acc)
+    return acc
+
+
+@triton.jit
+def _conv(
+    x_ptr,  # [T, C] current-token inputs (also the residual)
+    stride_x,
+    cache_ptr,  # [num_blocks, H, N, D] paged conv-state cache
+    cache_col,  # [C] offset of each channel within a cache block row
+    stride_c_blk,
+    stride_c_n,
+    N,
+    weight_ptr,  # static: [C, W]; dynamic: [W, C]
+    stride_w0,
+    stride_w1,
+    pos_ptr,  # [T] absolute positions
+    seq_idx_ptr,  # [T] request of each token
+    slot_ptr,  # [T] flat cache slot (< 0: padding)
+    block_table_ptr,  # [num_reqs, max_blocks]
+    stride_bt,
+    max_blocks,
+    qstart_ptr,  # [T] first row of each token's request
+    scale,
+    toff,
+    coff,
+    t_mask,
+    c_mask,
+    W: tl.constexpr,
+    dyn_ptr=None,  # dynamic: [T, C // HEAD_DIM, W]
+    stride_dyn=0,
+    HEAD_DIM: tl.constexpr = 1,
+    SKIP_IDLE_CACHE: tl.constexpr = False,
+    CACHE_FIRST: tl.constexpr = False,
+    tile_reads_cache=True,
+):
+    """Store the current inputs to the cache; return `y` in fp32.
+
+    With `CACHE_FIRST` (static W=4 conv), the taps from earlier steps are
+    loaded before `x`.
+    """
+    tc_mask = t_mask[:, None] & c_mask[None, :]
+    slot = tl.load(slot_ptr + toff, mask=t_mask, other=-1)
+    valid = slot >= 0
+    pos = tl.load(pos_ptr + toff, mask=t_mask, other=0)
+    req = tl.load(seq_idx_ptr + toff, mask=t_mask, other=0)
+    qstart = tl.load(qstart_ptr + toff, mask=t_mask, other=0)
+    if CACHE_FIRST:
+        tl.static_assert(W == 4 and dyn_ptr is None)
+        taps = (
+            cache_ptr,
+            cache_col,
+            stride_c_blk,
+            stride_c_n,
+            N,
+            c_mask,
+            block_table_ptr,
+            stride_bt,
+            max_blocks,
+            req,
+            pos,
+            toff,
+            qstart,
+            valid,
+        )
+        cached0 = _cached_tap(*taps, 3)
+        cached1 = _cached_tap(*taps, 2)
+        cached2 = _cached_tap(*taps, 1)
+        cached3 = _cached_tap(*taps, 0)
+
+    dtype = cache_ptr.dtype.element_ty
+    cur = tl.load(x_ptr + toff[:, None] * stride_x + coff[None, :], mask=tc_mask)
+    cur = cur.to(dtype)
+    safe_slot = tl.maximum(slot, 0)
+    dst = (
+        cache_ptr
+        + (safe_slot // N)[:, None] * stride_c_blk
+        + (safe_slot % N)[:, None] * stride_c_n
+        + cache_col[None, :]
+    )
+    tl.store(dst, cur, mask=tc_mask & valid[:, None])
+
+    tap_args = (
+        x_ptr,
+        stride_x,
+        cache_ptr,
+        cache_col,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        weight_ptr,
+        stride_w0,
+        stride_w1,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        toff,
+        coff,
+        c_mask,
+        tc_mask,
+        pos,
+        req,
+        qstart,
+        valid,
+        cur,
+    )
+    # Only tiles with a token among the first W - 1 of a request read taps
+    # from the cache; SKIP_IDLE_CACHE branches around the others' loads once.
+    if CACHE_FIRST:
+        preloaded = (cached0, cached1, cached2, cached3)
+        acc = _tap_sum(*tap_args, W, dyn_ptr, stride_dyn, HEAD_DIM, preloaded)
+    elif not SKIP_IDLE_CACHE or tile_reads_cache:
+        acc = _tap_sum(*tap_args, W, dyn_ptr, stride_dyn, HEAD_DIM, READ_CACHE=True)
+    else:
+        acc = _tap_sum(*tap_args, W, dyn_ptr, stride_dyn, HEAD_DIM)
+    return (acc + cur.to(tl.float32)) * scale
+
+
+@triton.jit
+def _sconv_kernel(
+    x_ptr,
+    cache_ptr,
+    weight_ptr,
+    out_ptr,  # [T, C]
+    res_ptr,  # [T, C] optional residual base, added before addend
+    addend_ptr,  # [T, C] optional
+    pos_ptr,
+    seq_idx_ptr,
+    slot_ptr,
+    block_table_ptr,
+    qstart_ptr,
+    T,
+    stride_x,
+    stride_c_blk,
+    stride_c_h,
+    stride_c_n,
+    stride_w0,
+    stride_w1,
+    stride_bt,
+    max_blocks,
+    N,
+    scale,
+    W: tl.constexpr,
+    OFF: tl.constexpr,
+    WS: tl.constexpr,
+    H: tl.constexpr,
+    HAS_RES: tl.constexpr,
+    HAS_ADDEND: tl.constexpr,
+    BT: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+    SKIP_IDLE_CACHE: tl.constexpr,
+):
+    first = tl.program_id(0) * BT
+    tile_reads_cache = True
+    if SKIP_IDLE_CACHE:
+        # Request starts are non-decreasing: no token of the tile is among the
+        # first W - 1 of its request unless the last token's request starts
+        # after first - (W - 1).
+        last = tl.minimum(first + BT, T) - 1
+        tile_reads_cache = tl.load(qstart_ptr + last) > first - (W - 1)
+    toff = first + tl.arange(0, BT)
+    coff = tl.program_id(1) * BLOCK_C + tl.arange(0, BLOCK_C)
+    C = H * WS
+    t_mask = toff < T
+    c_mask = coff < C
+    y = _conv(
+        x_ptr,
+        stride_x,
+        cache_ptr,
+        tl.minimum(coff // WS, H - 1) * stride_c_h + OFF + coff % WS,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        weight_ptr,
+        stride_w0,
+        stride_w1,
+        pos_ptr,
+        seq_idx_ptr,
+        slot_ptr,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        qstart_ptr,
+        scale,
+        toff,
+        coff,
+        t_mask,
+        c_mask,
+        W,
+        SKIP_IDLE_CACHE=SKIP_IDLE_CACHE,
+        CACHE_FIRST=not SKIP_IDLE_CACHE,
+        tile_reads_cache=tile_reads_cache,
+    ).to(out_ptr.dtype.element_ty)
+    offs = toff[:, None] * C + coff[None, :]
+    mask = t_mask[:, None] & c_mask[None, :]
+    if HAS_ADDEND:
+        # Residual update in the reference order: (res + addend) + y in fp32.
+        acc = tl.load(addend_ptr + offs, mask, other=0).to(tl.float32)
+        if HAS_RES:
+            acc = tl.load(res_ptr + offs, mask, other=0).to(tl.float32) + acc
+        y = (acc + y.to(tl.float32)).to(out_ptr.dtype.element_ty)
+    tl.store(out_ptr + offs, y, mask=mask)
+
+
+def short_conv(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    cache: torch.Tensor,
+    positions: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_idx: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    query_start: torch.Tensor,
+    stream_offset: int,
+    stream_width: int,
+    addend: torch.Tensor | None = None,
+    residual: torch.Tensor | None = None,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Insert `x` (rounded to the cache dtype) into the conv-state cache and
+    return the static convolution with `(C, W)` taps `weight`.
+
+    With `addend`, returns `(residual + addend) + y` accumulated in fp32
+    (`residual` may alias `out`).
+    """
+    num_tokens, channels = x.shape
+    if out is None:
+        out = torch.empty((num_tokens, channels), dtype=cache.dtype, device=x.device)
+    assert x.stride(1) == 1 and cache.stride(3) == 1 and out.is_contiguous()
+    assert residual is None or addend is not None
+    for t in (addend, residual):
+        assert t is None or (t.is_contiguous() and t.shape == out.shape)
+    num_heads = cache.shape[1]
+    assert channels == num_heads * stream_width
+    width = weight.shape[1]
+    # Prefill tiles skip the cache reads they never need.
+    prefill = num_tokens > 256
+    if num_tokens <= 8:
+        block_t, block_c = 1, 1024
+    else:
+        block_t, block_c = (4, 256) if prefill else (2, 512)
+    block_c = min(triton.next_power_of_2(channels), block_c)
+    grid = (triton.cdiv(num_tokens, block_t), triton.cdiv(channels, block_c))
+    _sconv_kernel[grid](
+        x,
+        cache,
+        weight,
+        out,
+        residual,
+        addend,
+        positions,
+        seq_idx,
+        slot_mapping,
+        block_table,
+        query_start,
+        num_tokens,
+        x.stride(0),
+        cache.stride(0),
+        cache.stride(1),
+        cache.stride(2),
+        weight.stride(0),
+        weight.stride(1),
+        block_table.stride(0),
+        block_table.shape[1],
+        cache.shape[2],
+        (width + 1) ** -0.5,
+        W=width,
+        OFF=stream_offset,
+        WS=stream_width,
+        H=num_heads,
+        HAS_RES=residual is not None,
+        HAS_ADDEND=addend is not None,
+        BT=block_t,
+        BLOCK_C=block_c,
+        SKIP_IDLE_CACHE=prefill,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return out
+
+
+# Columns of shift_rel_proj beyond the extent, 256 on either side.
+_SHIFT_PAD = 512
+
+
+def shift_rel_proj(rel_proj: torch.Tensor, is_local: bool) -> torch.Tensor:
+    """Return the `(8, d_rel + 1, extent + 512)` table `attention_prologue`
+    reads the `(d_rel, extent)` relative projection from, so that every
+    sheared output column block is an aligned slice of one of 8 shifts.
+
+    `out[s, :d_rel, y]` is `rel_proj[:, d]` for distance `d = s + extent
+    + 256 - y`, or zero out of range; row `d_rel` is the padding added to
+    the logits: -inf for negative distances and, if `is_local`, those past
+    the extent, else zero.
+    """
+    d_rel, extent = rel_proj.shape
+    shift = torch.arange(8, device=rel_proj.device)[:, None]
+    y = torch.arange(extent + _SHIFT_PAD, device=rel_proj.device)
+    dist = shift + extent + 256 - y
+    outside = (dist < 0) | (dist >= extent)
+    proj = rel_proj[:, dist.clamp(0, extent - 1)].transpose(0, 1)
+    pad = (dist >= extent) if is_local else torch.zeros_like(outside)
+    pad = (dist < 0) | pad
+    pad = torch.zeros_like(proj[:, :1]).masked_fill(pad[:, None], float("-inf"))
+    return torch.cat([proj.masked_fill(outside[:, None], 0), pad], 1).contiguous()
+
+
+@triton.jit
+def _attn_prologue_kernel(
+    k_ptr,  # [T, H * D] K projection
+    v_ptr,  # [T, H * D] V projection
+    wk_ptr,  # static: [H * D, W]; dynamic: [W, H * D]
+    wv_ptr,
+    dk_ptr,  # dynamic: [T, H, W] per-token K tap deltas
+    dv_ptr,
+    cache_ptr,
+    key_cache_ptr,  # [num_blocks, block_size, H, D]
+    value_cache_ptr,
+    kv_slot_ptr,  # [T] KV cache slot (< 0: skip)
+    pos_ptr,
+    seq_idx_ptr,
+    slot_ptr,
+    block_table_ptr,
+    qstart_ptr,
+    T,
+    stride_k,
+    stride_v,
+    stride_w0,
+    stride_w1,
+    stride_dk,
+    stride_dv,
+    stride_c_blk,
+    stride_c_h,
+    stride_c_n,
+    stride_kv_blk,
+    stride_kv_n,
+    stride_kv_h,
+    kv_block_size,
+    stride_bt,
+    max_blocks,
+    N,
+    scale,
+    clip_threshold,
+    clip_eps,
+    norm_eps,
+    q_ptr,  # [T, HQ, D] query projection (row-strided)
+    r_ptr,  # [T, HQ, D_REL] relative-query projection (row-strided)
+    q_scale_ptr,
+    r_scale_ptr,
+    tau_ptr,
+    rel_proj_ptr,
+    q_out_ptr,
+    rel_out_ptr,
+    cu_seqlens_q_ptr,
+    seq_lens_ptr,
+    stride_q,
+    stride_r,
+    rel_threshold,
+    W: tl.constexpr,
+    D: tl.constexpr,
+    DYNAMIC: tl.constexpr,
+    BT: tl.constexpr,
+    HQ: tl.constexpr,
+    D_REL: tl.constexpr,
+    E: tl.constexpr,
+    SHIFT_W: tl.constexpr,
+    HAS_TAU: tl.constexpr,
+    BLOCK_HQ: tl.constexpr,
+    BLOCK_E: tl.constexpr,
+    QR_TOKENS: tl.constexpr,
+):
+    # Programs (tile, head, 0 | 1) run the K | V conv of one KV head; programs
+    # (tile, head, 2) clip q of QR_TOKENS of the tile's tokens and programs
+    # (tile, head, 3 + c) their r and column block c of the relative logits.
+    if tl.program_id(2) >= 2:
+        if tl.program_id(1) * QR_TOKENS < BT:
+            qr_clip_rel_tokens(
+                tl.program_id(0) * BT + tl.program_id(1) * QR_TOKENS,
+                QR_TOKENS,
+                tl.program_id(2) - 3,
+                T,
+                q_ptr,
+                r_ptr,
+                q_scale_ptr,
+                r_scale_ptr,
+                tau_ptr,
+                rel_proj_ptr,
+                q_out_ptr,
+                rel_out_ptr,
+                seq_idx_ptr,
+                cu_seqlens_q_ptr,
+                seq_lens_ptr,
+                stride_q,
+                stride_r,
+                clip_threshold,
+                rel_threshold,
+                clip_eps,
+                HQ,
+                D,
+                D_REL,
+                E,
+                SHIFT_W,
+                HAS_TAU,
+                BLOCK_HQ,
+                BLOCK_E,
+            )
+    else:
+        _kv_conv_tile(
+            k_ptr,
+            v_ptr,
+            wk_ptr,
+            wv_ptr,
+            dk_ptr,
+            dv_ptr,
+            cache_ptr,
+            key_cache_ptr,
+            value_cache_ptr,
+            kv_slot_ptr,
+            pos_ptr,
+            seq_idx_ptr,
+            slot_ptr,
+            block_table_ptr,
+            qstart_ptr,
+            T,
+            stride_k,
+            stride_v,
+            stride_w0,
+            stride_w1,
+            stride_dk,
+            stride_dv,
+            stride_c_blk,
+            stride_c_h,
+            stride_c_n,
+            stride_kv_blk,
+            stride_kv_n,
+            stride_kv_h,
+            kv_block_size,
+            stride_bt,
+            max_blocks,
+            N,
+            scale,
+            clip_threshold,
+            clip_eps,
+            norm_eps,
+            W,
+            D,
+            DYNAMIC,
+            BT,
+        )
+
+
+@triton.jit
+def _kv_conv_tile(
+    k_ptr,
+    v_ptr,
+    wk_ptr,
+    wv_ptr,
+    dk_ptr,
+    dv_ptr,
+    cache_ptr,
+    key_cache_ptr,
+    value_cache_ptr,
+    kv_slot_ptr,
+    pos_ptr,
+    seq_idx_ptr,
+    slot_ptr,
+    block_table_ptr,
+    qstart_ptr,
+    T,
+    stride_k,
+    stride_v,
+    stride_w0,
+    stride_w1,
+    stride_dk,
+    stride_dv,
+    stride_c_blk,
+    stride_c_h,
+    stride_c_n,
+    stride_kv_blk,
+    stride_kv_n,
+    stride_kv_h,
+    kv_block_size,
+    stride_bt,
+    max_blocks,
+    N,
+    scale,
+    clip_threshold,
+    clip_eps,
+    norm_eps,
+    W: tl.constexpr,
+    D: tl.constexpr,
+    DYNAMIC: tl.constexpr,
+    BT: tl.constexpr,
+):
+    toff = tl.program_id(0) * BT + tl.arange(0, BT)
+    head = tl.program_id(1)
+    is_v = tl.program_id(2) == 1
+    d_idx = tl.arange(0, D)
+    coff = head * D + d_idx
+    t_mask = toff < T
+    if is_v:
+        x_ptr = v_ptr
+        w_ptr = wv_ptr
+        dyn_ptr = dv_ptr
+        stride_x = stride_v
+        stride_dyn = stride_dv
+    else:
+        x_ptr = k_ptr
+        w_ptr = wk_ptr
+        dyn_ptr = dk_ptr
+        stride_x = stride_k
+        stride_dyn = stride_dk
+    y = _conv(
+        x_ptr,
+        stride_x,
+        cache_ptr,
+        head * stride_c_h + tl.program_id(2) * D + d_idx,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        w_ptr,
+        stride_w0,
+        stride_w1,
+        pos_ptr,
+        seq_idx_ptr,
+        slot_ptr,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        qstart_ptr,
+        scale,
+        toff,
+        coff,
+        t_mask,
+        d_idx < D,
+        W,
+        dyn_ptr if DYNAMIC else None,
+        stride_dyn,
+        D,
+    )
+    y = y.to(k_ptr.dtype.element_ty).to(tl.float32)
+    sum_sq = tl.sum(y * y, axis=1)
+    if is_v:
+        y = y * tl.rsqrt(tl.div_rn(sum_sq, D) + norm_eps)[:, None]
+        cache = value_cache_ptr
+    else:
+        norm = tl.where(sum_sq > 0, sum_sq * tl.rsqrt(sum_sq), 0.0)
+        y = y * tl.minimum(tl.div_rn(clip_threshold, norm + clip_eps), 1.0)[:, None]
+        cache = key_cache_ptr
+    kv_slot = tl.load(kv_slot_ptr + toff, mask=t_mask, other=-1)
+    safe = tl.maximum(kv_slot, 0)
+    dst = (
+        cache
+        + (safe // kv_block_size)[:, None] * stride_kv_blk
+        + (safe % kv_block_size)[:, None] * stride_kv_n
+        + head * stride_kv_h
+        + d_idx[None, :]
+    )
+    tl.store(dst, y.to(cache.dtype.element_ty), mask=(kv_slot >= 0)[:, None])
+
+
+def attention_prologue(
+    q: torch.Tensor,
+    r: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    q_scale: torch.Tensor,
+    r_scale: torch.Tensor,
+    tau: torch.Tensor | None,
+    rel_proj: torch.Tensor,
+    k_weight: torch.Tensor,
+    v_weight: torch.Tensor,
+    k_dynamic: torch.Tensor | None,
+    v_dynamic: torch.Tensor | None,
+    cache: torch.Tensor,
+    positions: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_idx: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    query_start: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    kv_slot_mapping: torch.Tensor,
+    q_out: torch.Tensor,
+    rel_out: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    seq_lens: torch.Tensor,
+    *,
+    clip_threshold: float,
+    rel_threshold: float,
+    norm_eps: float,
+    clip_eps: float = 1e-6,
+) -> None:
+    """Attention input processing in one launch.
+
+    Writes the L2-clipped `q * q_scale` to `q_out` and the relative logits
+    of the clipped `r * r_scale` to `rel_out` (with `tau`, clipped values
+    are rounded, then scaled by the fp32 per-token `tau`). `rel_proj` is
+    the `shift_rel_proj` table; the logits come out sheared as
+    `rel_attention` reads them for a varlen launch over all tokens (`(T +
+    128, HQ, extent + 256)`) from the per-request `cu_seqlens_q` and
+    `seq_lens`. Runs the
+    K/V short convolutions, clips K, RMS-normalizes V and inserts both into
+    the KV cache (tokens with `kv_slot_mapping < 0` skip the write).
+
+    `q` `(T, HQ, D)`, `r` `(T, HQ, D_rel)` and `k`/`v`
+    `(T, H * D)` may be row-strided; K and V occupy `[0, D)` and
+    `[D, 2 * D)` of each conv-state head. Conv weights are static
+    `(H * D, W)` taps, or with `(T, H * W)` per-token deltas
+    `k/v_dynamic` the `(W, H * D)` static part.
+    """
+    num_tokens = kv_slot_mapping.shape[0]
+    num_heads, head_dim = key_cache.shape[2:]
+    num_q_heads, d_rel = r.shape[1:]
+    extent = rel_proj.shape[2] - _SHIFT_PAD
+    assert rel_proj.shape[:2] == (8, d_rel + 1)
+    assert k.stride(1) == v.stride(1) == 1 and cache.stride(3) == 1
+    assert key_cache.stride() == value_cache.stride() and key_cache.stride(3) == 1
+    assert k_weight.stride() == v_weight.stride()
+    assert q.shape[1:] == (num_q_heads, head_dim)
+    assert q_out.shape == q.shape
+    assert rel_out.shape == (q.shape[0] + 128, num_q_heads, extent + 256)
+    assert q.stride(2) == 1 and q.stride(1) == head_dim
+    assert r.stride(2) == 1 and r.stride(1) == d_rel
+    assert q_out.is_contiguous() and rel_out.is_contiguous()
+    assert q_scale.is_contiguous() and r_scale.is_contiguous()
+    assert rel_proj.is_contiguous() and d_rel >= 16
+    block_e = min(extent, 256)
+    for size in (head_dim, d_rel, block_e):
+        assert size & (size - 1) == 0, "tile sizes must be powers of 2"
+    assert extent % block_e == 0
+    dynamic = k_dynamic is not None
+    if dynamic:
+        assert k_dynamic is not None and v_dynamic is not None
+        width = k_weight.shape[0]
+        assert k_dynamic.stride(1) == v_dynamic.stride(1) == 1
+        dyn_strides = (k_dynamic.stride(0), v_dynamic.stride(0))
+    else:
+        width = k_weight.shape[1]
+        dyn_strides = (0, 0)
+    block_t = 4
+    grid = (triton.cdiv(num_tokens, block_t), num_heads, 3 + (extent + 256) // block_e)
+    _attn_prologue_kernel[grid](
+        k,
+        v,
+        k_weight,
+        v_weight,
+        # Unused placeholders for static convs keep both branches typed alike.
+        k_dynamic if dynamic else k_weight,
+        v_dynamic if dynamic else v_weight,
+        cache,
+        key_cache,
+        value_cache,
+        kv_slot_mapping,
+        positions,
+        seq_idx,
+        slot_mapping,
+        block_table,
+        query_start,
+        num_tokens,
+        k.stride(0),
+        v.stride(0),
+        k_weight.stride(0),
+        k_weight.stride(1),
+        *dyn_strides,
+        cache.stride(0),
+        cache.stride(1),
+        cache.stride(2),
+        key_cache.stride(0),
+        key_cache.stride(1),
+        key_cache.stride(2),
+        key_cache.shape[1],
+        block_table.stride(0),
+        block_table.shape[1],
+        cache.shape[2],
+        (width * (2 if dynamic else 1) + 1) ** -0.5,
+        clip_threshold,
+        clip_eps,
+        norm_eps,
+        q,
+        r,
+        q_scale,
+        r_scale,
+        tau,
+        rel_proj,
+        q_out,
+        rel_out,
+        cu_seqlens_q,
+        seq_lens,
+        q.stride(0),
+        r.stride(0),
+        rel_threshold,
+        W=width,
+        D=head_dim,
+        DYNAMIC=dynamic,
+        BT=block_t,
+        HQ=num_q_heads,
+        D_REL=d_rel,
+        E=extent,
+        SHIFT_W=rel_proj.shape[2],
+        HAS_TAU=tau is not None,
+        BLOCK_HQ=max(triton.next_power_of_2(num_q_heads), 16),
+        BLOCK_E=block_e,
+        QR_TOKENS=triton.cdiv(block_t, num_heads),
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
diff --git a/vllm/models/inkling2/amd/ops/triton_bmm.py b/vllm/models/inkling2/amd/ops/triton_bmm.py
new file mode 100644
index 0000000000..1ef022ce11
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/triton_bmm.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Triton batched expert GEMMs (`tl.dot_scaled`: gfx950's scaled MFMA; lowered
+to plain dots where the target has none) for the Inkling2 MoE: MXFP8
+activations with MXFP8 or MXFP4 (`ops.mxfp4`) expert weights.
+
+The GEMMs read expert-sorted activation rows whose expert segments are padded
+to the token tile, with block scales in the R8c4 (tile < 128) or R128c4 layout
+(`mxfp8`), and the expert weights and their block scales as stored in the
+checkpoint (row-major). Outputs are bf16.
+"""
+
+import functools
+from dataclasses import dataclass
+
+import torch
+
+from vllm.platforms.rocm import on_rdna4
+from vllm.triton_utils import tl, triton
+
+from .mxfp8 import _scale_offsets
+
+# Token tile by batch size (tokens up to the first entry); the smallest is one
+# 16-row MFMA tile.
+_TILES = ((128, 16), (384, 32), (768, 64), (4096, 128), (1 << 31, 256))
+
+
+@dataclass(frozen=True)
+class ExpertPlan:
+    """Token tile and launched tiles (an upper bound) for a batch."""
+
+    tile: int
+    max_ctas: int
+
+    @property
+    def rows(self) -> int:
+        return self.tile * self.max_ctas
+
+
+@functools.cache
+def expert_plan(
+    tokens: int, topk: int, num_experts: int, tile: int | None = None
+) -> ExpertPlan:
+    """Plan for `tokens` routed to `topk` of all experts, `num_experts`
+    of them local."""
+    if tile is None:
+        tile = next(t for max_tokens, t in _TILES if tokens <= max_tokens)
+    # Tiles if the local rows fill as many experts as possible, then pile up.
+    rows = tokens * topk
+    max_ctas = min(num_experts, rows) + (rows - min(num_experts, rows)) // tile
+    return ExpertPlan(tile, max_ctas)
+
+
+@triton.jit
+def _mxfp8_bmm_kernel(
+    A,
+    AScale,
+    W,
+    WScale,
+    Out,
+    Tiles,
+    max_ctas,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    TILE: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    W_E2M1: tl.constexpr,
+):
+    # Program (n, m) computes BM rows of token tile m // SUB: a part of it, or
+    # (for tiles below BM rows) the whole tile. Only routed rows are read and
+    # written: past them are the next tile's.
+    SUB: tl.constexpr = TILE // BM if TILE >= BM else 1
+    pid_m = tl.program_id(1)
+    tile = pid_m // SUB
+    if tile >= tl.load(Tiles + 2 * max_ctas):
+        return
+    row_end = tl.load(Tiles + max_ctas + tile)
+    row0 = tile * TILE + (pid_m % SUB) * BM
+    if row0 >= row_end:
+        return
+    expert = tl.load(Tiles + tile).to(tl.int64)
+    rows = row0 + tl.arange(0, BM)
+    row_mask = (rows < row_end)[:, None]
+    cols = tl.program_id(0) * BN + tl.arange(0, BN)
+    ks = tl.arange(0, BK)
+    groups = tl.arange(0, BK // 32)
+    a_ptrs = A + rows[:, None].to(tl.int64) * K + ks[None, :]
+    # MXFP4 weights pack two e2m1 values per byte along K.
+    WK: tl.constexpr = K // 2 if W_E2M1 else K
+    WBK: tl.constexpr = BK // 2 if W_E2M1 else BK
+    w_ptrs = W + (expert * N + cols[:, None]) * WK + tl.arange(0, WBK)[None, :]
+    ws_ptrs = WScale + (expert * N + cols[:, None]) * (K // 32) + groups[None, :]
+    acc = tl.zeros((BM, BN), tl.float32)
+    for k in range(0, K, BK):
+        scale_cols = k // 32 + groups[None, :]
+        a_scale_ptrs = AScale + _scale_offsets(rows[:, None], scale_cols, K // 32, TILE)
+        a = tl.load(a_ptrs + k, row_mask, other=0.0)
+        a_scale = tl.load(a_scale_ptrs, row_mask, other=0)
+        w_scale = tl.load(ws_ptrs + k // 32)
+        if W_E2M1:
+            w = tl.load(w_ptrs + k // 2)
+            acc = tl.dot_scaled(a, a_scale, "e4m3", tl.trans(w), w_scale, "e2m1", acc)
+        else:
+            w = tl.load(w_ptrs + k)
+            acc = tl.dot_scaled(a, a_scale, "e4m3", tl.trans(w), w_scale, "e4m3", acc)
+    out_ptrs = Out + rows[:, None].to(tl.int64) * N + cols[None, :]
+    tl.store(out_ptrs, acc.to(tl.bfloat16), row_mask)
+
+
+def bmm(
+    act: torch.Tensor,
+    act_scale: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    tiles: torch.Tensor,
+    plan: ExpertPlan,
+) -> torch.Tensor:
+    """bf16 `[plan.rows, N]` expert GEMM of the tile-padded MXFP8 `act` rows
+    with their swizzled block scales `act_scale`, by each tile's expert
+    (`tiles`: the `moe.route` metadata). Rows past each tile's routed rows
+    are left uninitialized. `weight` is MXFP8 (e4m3 `[E, N, K]`) or MXFP4
+    (uint8 `[E, N, K / 2]`, two e2m1 values per byte)."""
+    w_e2m1 = weight.dtype == torch.uint8
+    num_experts, n, k = weight.shape
+    if w_e2m1:
+        k *= 2
+    else:
+        assert weight.dtype == torch.float8_e4m3fn
+    assert act.shape == (plan.rows, k)
+    assert weight_scale.shape == (num_experts, n, k // 32)
+    assert weight.is_contiguous() and weight_scale.is_contiguous()
+    out = torch.empty((plan.rows, n), dtype=torch.bfloat16, device=act.device)
+    tile = plan.tile
+    bm = min(max(tile, 16), 128)
+    bn = 128 if n % 128 == 0 else 64
+    bk = 256 if k % 256 == 0 and bm >= 64 else 128
+    num_warps = 8 if bm == 128 and bk == 256 else 4
+    num_stages = 2
+    if on_rdna4():
+        # 64 KB of LDS per workgroup (gfx950: 160 KB): one stage of 128-wide
+        # K tiles.
+        bk, num_stages = 128, 1
+    assert n % bn == 0 and k % bk == 0
+    sub = tile // bm if tile >= bm else 1
+    _mxfp8_bmm_kernel[(n // bn, plan.max_ctas * sub)](
+        act,
+        act_scale,
+        weight,
+        weight_scale,
+        out,
+        tiles,
+        plan.max_ctas,
+        N=n,
+        K=k,
+        TILE=tile,
+        BM=bm,
+        BN=bn,
+        BK=bk,
+        W_E2M1=w_e2m1,
+        num_warps=num_warps,
+        num_stages=num_stages,
+    )
+    return out
diff --git a/vllm/models/inkling2/amd/ops/vision.py b/vllm/models/inkling2/amd/ops/vision.py
new file mode 100644
index 0000000000..4f13110767
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/vision.py
@@ -0,0 +1,335 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Triton kernels for the Inkling2 vision encoder.
+
+Rows are tokens of the packed images (a CLS row, then the native patches in
+row-major order). Row metadata is int32 `[T, 4]`: native `(y, x)` and the
+native grid `(height, width)`, with `y = x = -1` on CLS rows. Outputs are
+rounded to bf16 at the same points as the eager PyTorch ops they replace.
+"""
+
+import functools
+
+import torch
+
+from vllm.triton_utils import tl, tldevice, triton
+
+from .dspark import _round_bf16
+
+
+@functools.cache
+def _rope_inv_freq(head_dim: int, device: torch.device) -> torch.Tensor:
+    # Rounded from float64 to float32, matching the reference constants.
+    values = [10000.0 ** (-dim / head_dim) for dim in range(0, head_dim, 4)]
+    return torch.tensor(values, dtype=torch.float32, device=device)
+
+
+@triton.jit
+def _layer_norm(x, w_ptr, b_ptr, cols, mask, DIM: tl.constexpr, eps):
+    # x is zero outside mask; fp32 statistics as in torch's LayerNorm.
+    mean = tl.sum(x) / DIM
+    diff = tl.where(mask, x - mean, 0.0)
+    rstd = tl.math.rsqrt(tl.sum(diff * diff) / DIM + eps)
+    w = tl.load(w_ptr + cols, mask=mask).to(tl.float32)
+    b = tl.load(b_ptr + cols, mask=mask).to(tl.float32)
+    return tl.fma(w, diff * rstd, b)
+
+
+@triton.jit
+def _gather_patches_kernel(
+    pixels_ptr,
+    offsets_ptr,
+    out_ptr,
+    mean0,
+    mean1,
+    mean2,
+    clip_std0,
+    clip_std1,
+    clip_std2,
+    std0,
+    std1,
+    std2,
+    SIDE: tl.constexpr,
+    PATCH: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    # Raw RGB -> CLIP (rounded to bf16) -> PE [-1, 1] (rounded to bf16), each
+    # op in fp32 without FMA; features ordered (py, px, channel).
+    row = tl.program_id(0).to(tl.int64)
+    feature = tl.arange(0, BLOCK)
+    mask = feature < PATCH * PATCH * 3
+    channel = feature % 3
+    src = (
+        tl.load(offsets_ptr + row).to(tl.int64)
+        + (feature // (PATCH * 3)) * (SIDE * 3)
+        + feature % (PATCH * 3)
+    )
+    mean = tl.where(channel == 0, mean0, tl.where(channel == 1, mean1, mean2))
+    clip_std = tl.where(
+        channel == 0, clip_std0, tl.where(channel == 1, clip_std1, clip_std2)
+    )
+    std = tl.where(channel == 0, std0, tl.where(channel == 1, std1, std2))
+    value = tl.load(pixels_ptr + src, mask=mask).to(tl.float32)
+    value = _round_bf16(tl.div_rn(tl.div_rn(value, 255.0) - mean, clip_std))
+    value = 2.0 * (value * std + mean) - 1.0
+    tl.store(out_ptr + row * (PATCH * PATCH * 3) + feature, value, mask=mask)
+
+
+def gather_patches(
+    pixels: torch.Tensor,
+    offsets: torch.Tensor,
+    patch_size: int,
+    mean: tuple[float, float, float],
+    clip_std: tuple[float, float, float],
+    std: tuple[float, float, float],
+) -> torch.Tensor:
+    """Native patches of raw `[N, side, side, 3]` pixels as bf16 rows of
+    `(py, px, c)` values in [-1, 1].
+
+    Each value is `2 * (bf16((v / 255 - mean) / clip_std) * std + mean) - 1`.
+    `offsets[i]` is the element offset of row i's top-left pixel.
+    """
+    _, side, _, channels = pixels.shape
+    assert channels == 3 and pixels.is_contiguous()
+    features = patch_size * patch_size * 3
+    out = pixels.new_empty((offsets.numel(), features))
+    _gather_patches_kernel[(offsets.numel(),)](
+        pixels,
+        offsets,
+        out,
+        *mean,
+        *clip_std,
+        *std,
+        SIDE=side,
+        PATCH=patch_size,
+        BLOCK=triton.next_power_of_2(features),
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return out
+
+
+@triton.jit
+def _source_coords(index, target, SOURCE: tl.constexpr):
+    # align_corners=False bilinear coordinates, clamped to the source grid.
+    coord = tl.div_rn(float(SOURCE) * (index + 0.5), target) - 0.5
+    coord = tl.maximum(0.0, tl.minimum(coord, SOURCE - 1.0))
+    src0 = tl.floor(coord).to(tl.int64)
+    src1 = tl.minimum(src0 + 1, SOURCE - 1)
+    w1 = coord - src0.to(tl.float32)
+    return src0, src1, 1.0 - w1, w1
+
+
+@triton.jit
+def _lerp(a, b, wa, wb):
+    return tl.where(wa >= wb, tl.fma(a, wa, b * wb), tl.fma(b, wb, a * wa))
+
+
+@triton.jit(do_not_specialize=["eps"])
+def _embed_kernel(
+    patch_ptr,
+    patch_rows_ptr,
+    grid_ptr,
+    meta_ptr,
+    class_ptr,
+    cls_pos_ptr,
+    pre_w_ptr,
+    pre_b_ptr,
+    ln_w_ptr,
+    ln_b_ptr,
+    hidden_ptr,
+    normed_ptr,
+    eps,
+    SOURCE_HEIGHT: tl.constexpr,
+    SOURCE_WIDTH: tl.constexpr,
+    DIM: tl.constexpr,
+    BLOCK_DIM: tl.constexpr,
+):
+    # Patch embedding + resized position embedding (CLS rows: class + CLS
+    # position embedding), then ln_pre (the residual) and layer 0's ln_1.
+    row = tl.program_id(0).to(tl.int64)
+    dim = tl.arange(0, BLOCK_DIM)
+    mask = dim < DIM
+    meta = meta_ptr + row * 4
+    y = tl.load(meta)
+    if y < 0:
+        hidden = tl.load(class_ptr + dim, mask=mask).to(tl.float32)
+        hidden += tl.load(cls_pos_ptr + dim, mask=mask).to(tl.float32)
+    else:
+        x = tl.load(meta + 1).to(tl.float32)
+        height = tl.load(meta + 2).to(tl.float32)
+        width = tl.load(meta + 3).to(tl.float32)
+        y0, y1, wy0, wy1 = _source_coords(y.to(tl.float32), height, SOURCE_HEIGHT)
+        x0, x1, wx0, wx1 = _source_coords(x, width, SOURCE_WIDTH)
+        v00 = tl.load(grid_ptr + (y0 * SOURCE_WIDTH + x0) * DIM + dim, mask=mask)
+        v01 = tl.load(grid_ptr + (y0 * SOURCE_WIDTH + x1) * DIM + dim, mask=mask)
+        v10 = tl.load(grid_ptr + (y1 * SOURCE_WIDTH + x0) * DIM + dim, mask=mask)
+        v11 = tl.load(grid_ptr + (y1 * SOURCE_WIDTH + x1) * DIM + dim, mask=mask)
+        top = _lerp(v00.to(tl.float32), v01.to(tl.float32), wx0, wx1)
+        bottom = _lerp(v10.to(tl.float32), v11.to(tl.float32), wx0, wx1)
+        patch_row = tl.load(patch_rows_ptr + row).to(tl.int64)
+        hidden = tl.load(patch_ptr + patch_row * DIM + dim, mask=mask)
+        hidden = hidden.to(tl.float32) + _round_bf16(_lerp(top, bottom, wy0, wy1))
+    hidden = tl.where(mask, _round_bf16(hidden), 0.0)
+    hidden = _layer_norm(hidden, pre_w_ptr, pre_b_ptr, dim, mask, DIM, eps)
+    hidden = tl.where(mask, _round_bf16(hidden), 0.0)
+    tl.store(hidden_ptr + row * DIM + dim, hidden, mask=mask)
+    normed = _layer_norm(hidden, ln_w_ptr, ln_b_ptr, dim, mask, DIM, eps)
+    tl.store(normed_ptr + row * DIM + dim, normed, mask=mask)
+
+
+def embed_tokens(
+    patch_embeds: torch.Tensor,
+    patch_rows: torch.Tensor,
+    position_grid: torch.Tensor,
+    meta: torch.Tensor,
+    class_embedding: torch.Tensor,
+    cls_position_embedding: torch.Tensor,
+    ln_pre: torch.nn.LayerNorm,
+    ln_1: torch.nn.LayerNorm,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Returns `(hidden, ln_1(hidden))` with `hidden = ln_pre(embeddings)`.
+
+    Token row i takes patch embedding `patch_embeds[patch_rows[i]]`; CLS rows
+    (`patch_rows` unused) take the class embedding.
+    """
+    num_rows, dim = meta.shape[0], patch_embeds.shape[1]
+    assert ln_pre.eps == ln_1.eps
+    hidden = patch_embeds.new_empty((num_rows, dim))
+    normed = torch.empty_like(hidden)
+    _embed_kernel[(num_rows,)](
+        patch_embeds,
+        patch_rows,
+        position_grid,
+        meta,
+        class_embedding,
+        cls_position_embedding,
+        ln_pre.weight,
+        ln_pre.bias,
+        ln_1.weight,
+        ln_1.bias,
+        hidden,
+        normed,
+        ln_pre.eps,
+        SOURCE_HEIGHT=position_grid.shape[0],
+        SOURCE_WIDTH=position_grid.shape[1],
+        DIM=dim,
+        BLOCK_DIM=triton.next_power_of_2(dim),
+        num_warps=4,
+    )
+    return hidden, normed
+
+
+@triton.jit
+def _rotate_pair(even, odd, cos, sin):
+    return tl.fma(even, cos, -odd * sin), tl.fma(odd, cos, even * sin)
+
+
+@triton.jit
+def _rotary_qk_kernel(
+    qkv_ptr,
+    meta_ptr,
+    inv_freq_ptr,
+    stride_token,
+    NUM_HEADS: tl.constexpr,
+    HEAD_DIM: tl.constexpr,
+    BLOCK_HEADS: tl.constexpr,
+    BLOCK_PAIRS: tl.constexpr,
+):
+    token = tl.program_id(0).to(tl.int64)
+    head = tl.program_id(1) * BLOCK_HEADS + tl.arange(0, BLOCK_HEADS)[:, None]
+    pair = tl.arange(0, BLOCK_PAIRS)[None, :]
+    pair_mask = pair < HEAD_DIM // 2
+    mask = (head < NUM_HEADS) & pair_mask
+
+    # The first half of the pairs rotate by x + 1, the rest by y + 1 (CLS: 0).
+    inv_freq = tl.load(inv_freq_ptr + pair % (HEAD_DIM // 4), mask=pair_mask)
+    axis = tl.where(pair < HEAD_DIM // 4, 1, 0)
+    position = tl.load(meta_ptr + 4 * token + axis, mask=pair_mask, other=0) + 1
+    angle = position.to(tl.float32) * inv_freq
+    cos = tldevice.cos(angle)
+    sin = tldevice.sin(angle)
+
+    q_ptr = qkv_ptr + token * stride_token + head * HEAD_DIM + 2 * pair
+    k_ptr = q_ptr + NUM_HEADS * HEAD_DIM
+    q_even = tl.load(q_ptr, mask=mask, other=0.0).to(tl.float32)
+    q_odd = tl.load(q_ptr + 1, mask=mask, other=0.0).to(tl.float32)
+    k_even = tl.load(k_ptr, mask=mask, other=0.0).to(tl.float32)
+    k_odd = tl.load(k_ptr + 1, mask=mask, other=0.0).to(tl.float32)
+    q_even, q_odd = _rotate_pair(q_even, q_odd, cos, sin)
+    k_even, k_odd = _rotate_pair(k_even, k_odd, cos, sin)
+    tl.store(q_ptr, q_even, mask=mask)
+    tl.store(q_ptr + 1, q_odd, mask=mask)
+    tl.store(k_ptr, k_even, mask=mask)
+    tl.store(k_ptr + 1, k_odd, mask=mask)
+
+
+def apply_rotary_qk_(qkv: torch.Tensor, meta: torch.Tensor, num_heads: int) -> None:
+    """In-place interleaved 2D RoPE on the q and k thirds of `qkv [T, 3D]`."""
+    num_tokens, width = qkv.shape
+    head_dim = width // (3 * num_heads)
+    block_heads = min(4, triton.next_power_of_2(num_heads))
+    grid = (num_tokens, triton.cdiv(num_heads, block_heads))
+    _rotary_qk_kernel[grid](
+        qkv,
+        meta,
+        _rope_inv_freq(head_dim, qkv.device),
+        qkv.stride(0),
+        NUM_HEADS=num_heads,
+        HEAD_DIM=head_dim,
+        BLOCK_HEADS=block_heads,
+        BLOCK_PAIRS=triton.next_power_of_2(head_dim // 2),
+        num_warps=4,
+    )
+
+
+@triton.jit(do_not_specialize=["eps"])
+def _scaled_residual_norm_kernel(
+    hidden_ptr,
+    update_ptr,
+    gamma_ptr,
+    ln_w_ptr,
+    ln_b_ptr,
+    normed_ptr,
+    eps,
+    DIM: tl.constexpr,
+    BLOCK_DIM: tl.constexpr,
+    HAS_NORM: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    dim = tl.arange(0, BLOCK_DIM)
+    mask = dim < DIM
+    update = tl.load(update_ptr + row * DIM + dim, mask=mask).to(tl.float32)
+    gamma = tl.load(gamma_ptr + dim, mask=mask).to(tl.float32)
+    hidden = tl.load(hidden_ptr + row * DIM + dim, mask=mask).to(tl.float32)
+    hidden = tl.where(mask, _round_bf16(hidden + _round_bf16(update * gamma)), 0.0)
+    tl.store(hidden_ptr + row * DIM + dim, hidden, mask=mask)
+    if HAS_NORM:
+        normed = _layer_norm(hidden, ln_w_ptr, ln_b_ptr, dim, mask, DIM, eps)
+        tl.store(normed_ptr + row * DIM + dim, normed, mask=mask)
+
+
+def scaled_residual_norm_(
+    hidden: torch.Tensor,
+    update: torch.Tensor,
+    gamma: torch.Tensor,
+    norm: torch.nn.LayerNorm | None,
+) -> torch.Tensor | None:
+    """`hidden += update * gamma` in place; returns `norm(hidden)`."""
+    num_rows, dim = hidden.shape
+    assert hidden.is_contiguous() and update.is_contiguous()
+    normed = None if norm is None else torch.empty_like(hidden)
+    _scaled_residual_norm_kernel[(num_rows,)](
+        hidden,
+        update,
+        gamma,
+        None if norm is None else norm.weight,
+        None if norm is None else norm.bias,
+        normed,
+        0.0 if norm is None else norm.eps,
+        DIM=dim,
+        BLOCK_DIM=triton.next_power_of_2(dim),
+        HAS_NORM=norm is not None,
+        num_warps=4,
+    )
+    return normed
