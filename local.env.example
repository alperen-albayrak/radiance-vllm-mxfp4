# Settings of ./up.sh. Copy to local.env (not tracked by git) and edit.

# Where setup-mxfp4.sh put the checkpoints.
MODELS=$HOME/models

# qwen3.8 or daisyrose (prepare it once with MODEL=daisyrose ./setup-mxfp4.sh), or the name of
# any other checkpoint directory under MODELS.
MODEL=qwen3.8

# Model name(s) clients ask for; the first is the one to use. Default: the model's own name.
#SERVED_NAMES="Qwen3.8"

#PORT=8080

# 1 or 2. Default: two when there are two usable cards.
#CARDS=2

# Settings of the two-card serve (vnext/serve.sh lists all of them):
#MAXSEQS=4        # requests served at the same time

# Sampling for requests that set none. Default: temperature 1.0 for daisyrose, 0.7 otherwise.
#GEN='{"temperature":1.0,"top_p":0.95,"top_k":20}'
